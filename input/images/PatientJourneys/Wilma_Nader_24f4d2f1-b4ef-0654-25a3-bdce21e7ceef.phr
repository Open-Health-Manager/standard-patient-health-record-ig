s.gov","code":"0","display":"Always continent (no documented incontinence)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26833-6","display":"Always continent (no documented incontinence)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Stress incontinence only"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26736-1","display":"Stress incontinence only"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Incontinent less than daily (e.g., once or twice during the 3-day assessment period)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26834-4","display":"Incontinent less than daily (e.g., once or twice during the 3-day assessment period)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Incontinent daily (at least once a day)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9979-1","display":"Incontinent daily (at least once a day)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Always incontinent"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9934-6","display":"Always incontinent"}},{"valueCoding":{"system":"http://del.cms.gov","code":"5","display":"No urine output (e.g., renal failure)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26738-7","display":"No urine output (e.g., renal failure)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Not applicable (e.g., indwelling catheter)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11693-1","display":"Not applicable (e.g., indwelling catheter)"}}],"id":"item.7.item.1","description":"Please select the one category that best describes the patient's or resident's bladder continence."},{"linkId":"Section-9","code":[{"system":"http://loinc.org","code":"83264-2","display":"IRF-PAI - Active diagnoses [CMS Assessment]"}],"text":"Section I: Active Diagnoses","type":"group","readOnly":true,"item":[{"linkId":"Section-9/I0000","prefix":"I0000","text":"Active Diagnoses in the last 7 days: Check all that apply. Diagnoses listed in parentheses are provided as examples and should not be considered as all-inclusive lists","type":"choice","repeats":true,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"I0900","display":"Peripheral Vascular Disease (PVD) or Peripheral Arterial Disease (PAD)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA18399-8","display":"Peripheral vascular disease (PVD) or peripheral arterial disease (PAD)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"I2900","display":"Diabetes Mellitus (DM) (e.g., diabetic retinopathy, nephropathy, and neuropathy)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26741-1","display":"Diabetes mellitus (DM) (e.g., diabetic retinopathy, nephropathy, and neuropathy)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"I7900","display":"None of the above active diagnoses"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9-3","display":"None of the above"}}],"id":"item.8.item.0"}],"id":"item.8","description":"In Section I of the form, the patient's active diagnoses are listed."},{"linkId":"Section-9/I0000","prefix":"I0000","text":"Active Diagnoses in the last 7 days: Check all that apply. Diagnoses listed in parentheses are provided as examples and should not be considered as all-inclusive lists","type":"choice","repeats":true,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"I0900","display":"Peripheral Vascular Disease (PVD) or Peripheral Arterial Disease (PAD)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA18399-8","display":"Peripheral vascular disease (PVD) or peripheral arterial disease (PAD)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"I2900","display":"Diabetes Mellitus (DM) (e.g., diabetic retinopathy, nephropathy, and neuropathy)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26741-1","display":"Diabetes mellitus (DM) (e.g., diabetic retinopathy, nephropathy, and neuropathy)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"I7900","display":"None of the above active diagnoses"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9-3","display":"None of the above"}}],"id":"item.8.item.0","description":"The patient has been asked to indicate all of their active diagnoses from the last 7 days on the form. They should check all that apply. The diagnoses provided in parentheses are just examples and should not be considered as an all-inclusive list."},{"linkId":"Section-10","code":[{"system":"http://loinc.org","code":"83273-3","display":"IRF-PAI - Health conditions - admission [CMS Assessment]"}],"text":"Section J: Health Conditions","type":"group","readOnly":true,"item":[{"linkId":"Section-10/J1750","prefix":"J1750","text":"History of Falls: Has the {patient/resident} had two or more falls in the past year or any fall with injury in the past year?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}},{"valueCoding":{"system":"http://del.cms.gov","code":"8","display":"Unknown"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4489-6","display":"Unknown"}}],"id":"item.9.item.0"},{"linkId":"Section-10/J2000","prefix":"J2000","text":"Prior Surgery. Did the {patient/resident} have major surgery during the 100 days prior to admission?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}},{"valueCoding":{"system":"http://del.cms.gov","code":"8","display":"Unknown"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4489-6","display":"Unknown"}}],"id":"item.9.item.1"}],"id":"item.9","description":"In Section J of the form, the patient's health conditions are being evaluated."},{"linkId":"Section-10/J1750","prefix":"J1750","text":"History of Falls: Has the {patient/resident} had two or more falls in the past year or any fall with injury in the past year?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}},{"valueCoding":{"system":"http://del.cms.gov","code":"8","display":"Unknown"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4489-6","display":"Unknown"}}],"id":"item.9.item.0","description":"Does the patient or resident have a history of having two or more falls in the past year, or any fall that resulted in injury in the past year?"},{"linkId":"Section-10/J2000","prefix":"J2000","text":"Prior Surgery. Did the {patient/resident} have major surgery during the 100 days prior to admission?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}},{"valueCoding":{"system":"http://del.cms.gov","code":"8","display":"Unknown"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4489-6","display":"Unknown"}}],"id":"item.9.item.1","description":"Did the patient or resident have any major surgery during the 100 days prior to their admission?"},{"linkId":"Section-11","code":[{"system":"http://loinc.org","code":"83244-4","display":"IRF-PAI v2.0 - Swallowing/nutritional status - admission [CMS Assessment]"}],"text":"Section K: Swallowing/Nutritional Status","type":"group","readOnly":true,"item":[{"linkId":"Section-11/K0110","prefix":"K0110","text":"Swallowing/Nutritional Status. Indicate the {patient's/resident's} usual ability to swallow: Check all that apply","type":"choice","repeats":true,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"A","display":"Regular food - Solids and liquids swallowed safely without supervision or modified food or liquid consistency."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10070-3","display":"Regular food: solids and liquids swallowed safely without supervision and without modified food or liquid consistency."}},{"valueCoding":{"system":"http://del.cms.gov","code":"B","display":"Modified food consistency/supervision - {Patient/Resident} requires modified food or liquid consistency and/or needs supervision during eating for safety."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10013-3","display":"Modified food consistency/supervision: Patient requires modified food or liquid consistency and/or needs supervision during eating for safety."}},{"valueCoding":{"system":"http://del.cms.gov","code":"C","display":"Tube/parenteral feeding - Tube/parenteral feeding used wholly or partially as a means of sustenance."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10103-2","display":"Tube/parenteral feeding: Tube/parenteral feeding used wholly or partially as a means of sustenance."}}],"id":"item.10.item.0"}],"id":"item.10","description":"In Section K of the form, the patient's swallowing and nutritional status is assessed."},{"linkId":"Section-11/K0110","prefix":"K0110","text":"Swallowing/Nutritional Status. Indicate the {patient's/resident's} usual ability to swallow: Check all that apply","type":"choice","repeats":true,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"A","display":"Regular food - Solids and liquids swallowed safely without supervision or modified food or liquid consistency."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10070-3","display":"Regular food: solids and liquids swallowed safely without supervision and without modified food or liquid consistency."}},{"valueCoding":{"system":"http://del.cms.gov","code":"B","display":"Modified food consistency/supervision - {Patient/Resident} requires modified food or liquid consistency and/or needs supervision during eating for safety."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10013-3","display":"Modified food consistency/supervision: Patient requires modified food or liquid consistency and/or needs supervision during eating for safety."}},{"valueCoding":{"system":"http://del.cms.gov","code":"C","display":"Tube/parenteral feeding - Tube/parenteral feeding used wholly or partially as a means of sustenance."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10103-2","display":"Tube/parenteral feeding: Tube/parenteral feeding used wholly or partially as a means of sustenance."}}],"id":"item.10.item.0","description":"Please indicate the patient's usual ability to swallow regarding their swallowing or nutritional status. Check all that apply."},{"linkId":"Section-13","code":[{"system":"http://loinc.org","code":"85055-2","display":"IRF-PAI v3.0, LCDS v4.00 - Skin conditions - admission [CMS Assessment]"}],"text":"Section M: Skin Conditions","type":"group","readOnly":true,"item":[{"linkId":"Section-13/M0210","prefix":"M0210","text":"Unhealed Pressure Ulcers/Injuries. Does this {patient/resident} have one or more unhealed pressure ulcers/injuries?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}],"id":"item.11.item.0"},{"linkId":"Section-13/M0300B1","prefix":"M0300B1","text":"Number of Stage 2 pressure ulcers","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.1"},{"linkId":"Section-13/M0300C1","prefix":"M0300C1","text":"Number of Stage 3 pressure ulcers","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.2"},{"linkId":"Section-13/M0300D1","prefix":"M0300D1","text":"Number of Stage 4 pressure ulcers","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.3"},{"linkId":"Section-13/M0300E1","prefix":"M0300E1","text":"Number of unstageable pressure ulcers/injuries due to non-removable dressing/device","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.4"},{"linkId":"Section-13/M0300F1","prefix":"M0300F1","text":"Number of unstageable pressure ulcers due to coverage of wound bed by slough and/or eschar","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.5"},{"linkId":"Section-13/M0300G1","prefix":"M0300G1","text":"Number of unstageable pressure injuries presenting as deep tissue injury","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.6"},{"linkId":"Section-13/M0300","prefix":"M0300","text":"Current Number of Unhealed Pressure Ulcers/Injuries at Each Stage","type":"group","repeats":false,"readOnly":true,"item":[{"linkId":"Section-13/M0300A","prefix":"M0300A","text":"Stage 1: Intact skin with non-blanchable redness of a localized area usually over a bony prominence. Darkly pigmented skin may not have a visible blanching; in dark skin tones only it may appear with persistent blue or purple hues","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.0"},{"linkId":"Section-13/M0300B","prefix":"M0300B","text":"Stage 2: Partial thickness loss of dermis presenting as a shallow open ulcer with a red or pink wound bed, without slough. May also present as an intact or open/ruptured blister.","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.1"},{"linkId":"Section-13/M0300C","prefix":"M0300C","text":"Stage 3: Full thickness tissue loss. Subcutaneous fat may be visible but bone, tendon or muscle is not exposed. Slough may be present but does not obscure the depth of tissue loss. May include undermining and tunneling","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.2"},{"linkId":"Section-13/M0300D","prefix":"M0300D","text":"Stage 4: Full thickness tissue loss with exposed bone, tendon or muscle. Slough or eschar may be present on some parts of the wound bed. Often includes undermining and tunneling","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.3"},{"linkId":"Section-13/M0300E","prefix":"M0300E","text":"Unstageable - Non-removable dressing/device: Known but not stageable due to non-removable dressing/device","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.4"},{"linkId":"Section-13/M0300F","prefix":"M0300F","text":"Unstageable - Slough and/or eschar: Known but not stageable due to coverage of wound bed by slough and/or eschar","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.5"},{"linkId":"Section-13/M0300G","prefix":"M0300G","text":"Unstageable - Deep tissue injury","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.6"}],"id":"item.11.item.7"},{"linkId":"Section-13/M0300A1","prefix":"M0300A1","text":"Number of Stage 1 pressure injuries","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.8"}],"id":"item.11","description":"In Section M of the form, the patient's skin conditions are addressed."},{"linkId":"Section-13/M0210","prefix":"M0210","text":"Unhealed Pressure Ulcers/Injuries. Does this {patient/resident} have one or more unhealed pressure ulcers/injuries?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}],"id":"item.11.item.0","description":"Does this patient or resident have one or more unhealed pressure ulcers or injuries?"},{"linkId":"Section-13/M0300B1","prefix":"M0300B1","text":"Number of Stage 2 pressure ulcers","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.1","description":"The patient has how many Stage 2 pressure ulcers?"},{"linkId":"Section-13/M0300C1","prefix":"M0300C1","text":"Number of Stage 3 pressure ulcers","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.2","description":"How many stage 3 pressure ulcers does the patient have?"},{"linkId":"Section-13/M0300D1","prefix":"M0300D1","text":"Number of Stage 4 pressure ulcers","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.3","description":"The patient has a certain number of Stage 4 pressure ulcers."},{"linkId":"Section-13/M0300E1","prefix":"M0300E1","text":"Number of unstageable pressure ulcers/injuries due to non-removable dressing/device","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.4","description":"How many unstageable pressure ulcers/injuries does the patient have due to a non-removable dressing/device?"},{"linkId":"Section-13/M0300F1","prefix":"M0300F1","text":"Number of unstageable pressure ulcers due to coverage of wound bed by slough and/or eschar","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.5","description":"How many unstageable pressure ulcers does the patient have due to coverage of the wound bed by slough and/or eschar?"},{"linkId":"Section-13/M0300G1","prefix":"M0300G1","text":"Number of unstageable pressure injuries presenting as deep tissue injury","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.6","description":"The patient has a certain number of unstageable pressure injuries that present as deep tissue injury."},{"linkId":"Section-13/M0300","prefix":"M0300","text":"Current Number of Unhealed Pressure Ulcers/Injuries at Each Stage","type":"group","repeats":false,"readOnly":true,"item":[{"linkId":"Section-13/M0300A","prefix":"M0300A","text":"Stage 1: Intact skin with non-blanchable redness of a localized area usually over a bony prominence. Darkly pigmented skin may not have a visible blanching; in dark skin tones only it may appear with persistent blue or purple hues","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.0"},{"linkId":"Section-13/M0300B","prefix":"M0300B","text":"Stage 2: Partial thickness loss of dermis presenting as a shallow open ulcer with a red or pink wound bed, without slough. May also present as an intact or open/ruptured blister.","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.1"},{"linkId":"Section-13/M0300C","prefix":"M0300C","text":"Stage 3: Full thickness tissue loss. Subcutaneous fat may be visible but bone, tendon or muscle is not exposed. Slough may be present but does not obscure the depth of tissue loss. May include undermining and tunneling","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.2"},{"linkId":"Section-13/M0300D","prefix":"M0300D","text":"Stage 4: Full thickness tissue loss with exposed bone, tendon or muscle. Slough or eschar may be present on some parts of the wound bed. Often includes undermining and tunneling","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.3"},{"linkId":"Section-13/M0300E","prefix":"M0300E","text":"Unstageable - Non-removable dressing/device: Known but not stageable due to non-removable dressing/device","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.4"},{"linkId":"Section-13/M0300F","prefix":"M0300F","text":"Unstageable - Slough and/or eschar: Known but not stageable due to coverage of wound bed by slough and/or eschar","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.5"},{"linkId":"Section-13/M0300G","prefix":"M0300G","text":"Unstageable - Deep tissue injury","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.6"}],"id":"item.11.item.7","description":"The form is asking for the current number of unhealed pressure ulcers/injuries at each stage that the patient has."},{"linkId":"Section-13/M0300A","prefix":"M0300A","text":"Stage 1: Intact skin with non-blanchable redness of a localized area usually over a bony prominence. Darkly pigmented skin may not have a visible blanching; in dark skin tones only it may appear with persistent blue or purple hues","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.0","description":"The patient's condition is at Stage 1, where there is intact skin with non-blanchable redness of a localized area, usually over a bony prominence. It is noted that darkly pigmented skin may not exhibit visible blanching. In such cases, dark skin tones may only appear with persistent blue or purple hues."},{"linkId":"Section-13/M0300B","prefix":"M0300B","text":"Stage 2: Partial thickness loss of dermis presenting as a shallow open ulcer with a red or pink wound bed, without slough. May also present as an intact or open/ruptured blister.","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.1","description":"The patient is at stage 2, which indicates a partial thickness loss of dermis presenting as a shallow open ulcer with a red or pink wound bed, without slough. This may also present as an intact or open/ruptured blister."},{"linkId":"Section-13/M0300C","prefix":"M0300C","text":"Stage 3: Full thickness tissue loss. Subcutaneous fat may be visible but bone, tendon or muscle is not exposed. Slough may be present but does not obscure the depth of tissue loss. May include undermining and tunneling","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.2","description":"The patient is at stage 3, which indicates full thickness tissue loss. At this stage, subcutaneous fat may be visible, but bone, tendon, or muscle is not exposed. Slough may be present but it does not obscure the depth of tissue loss. This stage may also include undermining and tunneling."},{"linkId":"Section-13/M0300D","prefix":"M0300D","text":"Stage 4: Full thickness tissue loss with exposed bone, tendon or muscle. Slough or eschar may be present on some parts of the wound bed. Often includes undermining and tunneling","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.3","description":"The patient has stage 4 skin integrity, characterized by full thickness tissue loss with exposed bone, tendon, or muscle. There may be slough or eschar present on some parts of the wound bed, and the condition often includes undermining and tunneling."},{"linkId":"Section-13/M0300E","prefix":"M0300E","text":"Unstageable - Non-removable dressing/device: Known but not stageable due to non-removable dressing/device","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.4","description":"The patient has an unstageable condition due to a non-removable dressing or device, although the exact stage is known but cannot be identified because of the non-removable dressing or device."},{"linkId":"Section-13/M0300F","prefix":"M0300F","text":"Unstageable - Slough and/or eschar: Known but not stageable due to coverage of wound bed by slough and/or eschar","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.5","description":"The patient has a known, but unstageable wound due to the coverage of the wound bed by slough and/or eschar."},{"linkId":"Section-13/M0300G","prefix":"M0300G","text":"Unstageable - Deep tissue injury","type":"group","repeats":false,"readOnly":true,"id":"item.11.item.7.item.6","description":"The patient has an unstageable deep tissue injury."},{"linkId":"Section-13/M0300A1","prefix":"M0300A1","text":"Number of Stage 1 pressure injuries","type":"integer","repeats":false,"readOnly":false,"maxLength":1,"id":"item.11.item.8","description":"How many Stage 1 pressure injuries does the patient have?"},{"linkId":"Section-14","code":[{"system":"http://loinc.org","code":"88872-7","display":"IRF-PAI v2.0 - Medications - admission [CMS Assessment]"}],"text":"Section N: Medications","type":"group","readOnly":true,"item":[{"linkId":"Section-14/N2001","prefix":"N2001","text":"Drug Regimen Review: Did a complete drug regimen review identify potential clinically significant medication issues?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No - No issues found during review"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27634-7","display":"No - No issues found during review"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes - Issues found during review"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27635-4","display":"Yes - Issues found during review"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Not applicable - {Patient/Resident} is not taking any medications"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27636-2","display":"NA - Patient is not taking any medications"}}],"id":"item.12.item.0"},{"linkId":"Section-14/N2003","prefix":"N2003","text":"Medication Follow-up. Did the {facility/setting} contact a physician (or physician-designee) by midnight of the next calendar day and complete prescribed/recommended actions in response to the identified potential clinically significant medication issues?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}],"id":"item.12.item.1"}],"id":"item.12","description":"In Section N of the form, the medications that the patient is currently taking are listed."},{"linkId":"Section-14/N2001","prefix":"N2001","text":"Drug Regimen Review: Did a complete drug regimen review identify potential clinically significant medication issues?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No - No issues found during review"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27634-7","display":"No - No issues found during review"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes - Issues found during review"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27635-4","display":"Yes - Issues found during review"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Not applicable - {Patient/Resident} is not taking any medications"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27636-2","display":"NA - Patient is not taking any medications"}}],"id":"item.12.item.0","description":"Did a complete drug regimen review identify any potential clinically significant medication issues for the patient? The options are 'Yes', 'No', and 'Not applicable'."},{"linkId":"Section-14/N2003","prefix":"N2003","text":"Medication Follow-up. Did the {facility/setting} contact a physician (or physician-designee) by midnight of the next calendar day and complete prescribed/recommended actions in response to the identified potential clinically significant medication issues?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}],"id":"item.12.item.1","description":"Did the facility or setting in question contact a physician or a physician's designee by midnight of the following calendar day and complete the prescribed or recommended actions in response to the identified potential clinically significant medication issues related to the patient?"},{"linkId":"Section-15","code":[{"system":"http://loinc.org","code":"83261-8","display":"IRF-PAI v3.0 - Special treatments, procedures, and programs - admission [CMS Assessment]"}],"text":"Section O: Special Treatments, Procedures, and Programs","type":"group","readOnly":true,"item":[{"linkId":"Section-15/O0100","prefix":"O0100","text":"Special Treatments, Procedures, and Programs. Check all of the following treatments, procedures, and programs that were performed","type":"choice","repeats":true,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"N","display":"Total Parenteral Nutrition"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10101-6","display":"Total parenteral nutrition"}}],"id":"item.13.item.0"}],"id":"item.13","description":"In Section O of the form, the patient is asked about special treatments, procedures, and programs they may have undergone."},{"linkId":"Section-15/O0100","prefix":"O0100","text":"Special Treatments, Procedures, and Programs. Check all of the following treatments, procedures, and programs that were performed","type":"choice","repeats":true,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"N","display":"Total Parenteral Nutrition"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10101-6","display":"Total parenteral nutrition"}}],"id":"item.13.item.0","description":"Please indicate all of the special treatments, procedures, and programs that were performed on the patient."},{"linkId":"Section-19","text":"Section Z: Assessment Administration","type":"group","readOnly":true,"item":[{"linkId":"Section-19/Z0400","prefix":"Z0400","text":"Signature of Persons Completing the Assessment","type":"group","repeats":false,"readOnly":true,"item":[{"linkId":"Section-19/Z0400A","prefix":"Z0400A","text":"Signature, Title, Sections, Date Section Completed A","type":"text","repeats":false,"readOnly":false,"maxLength":100,"id":"item.14.item.0.item.0"},{"linkId":"Section-19/Z0400B","prefix":"Z0400B","text":"Signature, Title, Sections, Date Section Completed B","type":"text","repeats":false,"readOnly":false,"maxLength":100,"id":"item.14.item.0.item.1"},{"linkId":"Section-19/Z0400C","prefix":"Z0400C","text":"Signature, Title, Sections, Date Section Completed C","type":"text","repeats":false,"readOnly":false,"maxLength":100,"id":"item.14.item.0.item.2"},{"linkId":"Section-19/Z0400D","prefix":"Z0400D","text":"Signature, Title, Sections, Date Section Completed D","type":"text","repeats":false,"readOnly":false,"maxLength":100,"id":"item.14.item.0.item.3"},{"linkId":"Section-19/Z0400E","prefix":"Z0400E","text":"Signature, Title, Sections, Date Section Completed E","type":"text","repeats":false,"readOnly":false,"maxLength":100,"id":"item.14.item.0.item.4"},{"linkId":"Section-19/Z0400F","prefix":"Z0400F","text":"Signature, Title, Sections, Date Section Completed F","type":"text","repeats":false,"readOnly":false,"maxLength":100,"id":"item.14.item.0.item.5"},{"linkId":"Section-19/Z0400G","prefix":"Z0400G","text":"Signature, Title, Sections, Date Section Completed G","type":"text","repeats":false,"readOnly":false,"maxLength":100,"id":"item.14.item.0.item.6"},{"linkId":"Section-19/Z0400H","prefix":"Z0400H","text":"Signature, Title, Sections, Date Section Completed H","type":"text","repeats":false,"readOn