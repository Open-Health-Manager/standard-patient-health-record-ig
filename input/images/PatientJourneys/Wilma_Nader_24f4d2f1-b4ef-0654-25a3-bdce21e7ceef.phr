y":"{Patient/Resident} refused"}},{"valueCoding":{"system":"http://loinc.org","code":"LA30915-5","display":"Person refused."}},{"valueCoding":{"system":"http://del.cms.gov","code":"11","display":"Not applicable - {Patient/Resident} does not usually do this activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30916-3","display":"Not applicable - Person does not usually do this activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"90","display":"Not attempted due to short-term medical condition or safety concerns."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30917-1","display":"Not attempted due to short-term medical condition or safety concerns."}}]},{"linkId":"Section-37/GG0175H8","prefix":"GG0175H8","text":"The form is asking about the patient's ability to wheel at least 150 feet in a corridor or similar space once they are seated in a wheelchair or scooter. The answer choices include 'Motorized Wheelchair/Scooter' and 'Most Dependent Performance'.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"06","display":"Independent - {Patient/Resident} completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30909-8","display":"Independent - Person completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://del.cms.gov","code":"05","display":"Setup or clean-up assistance - Helper sets up or cleans up; {patient/resident} completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30910-6","display":"Setup or cleanup assistance - Helper sets up or cleans up; person completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"04","display":"Supervision or touching assistance - Helper provides verbal cues and/