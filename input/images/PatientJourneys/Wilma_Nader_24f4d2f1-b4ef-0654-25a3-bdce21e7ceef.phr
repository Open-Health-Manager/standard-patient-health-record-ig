n-48/Z0400B","prefix":"Z0400B","text":"Signature, Title, Sections, Date Section Completed B","type":"text","repeats":false,"readOnly":false,"maxLength":100,"id":"item.6.item.0.item.1","description":"The patient is required to provide their signature and title, and then complete section B, after which they must record the date the section was completed."},{"linkId":"Section-48/Z0400C","prefix":"Z0400C","text":"Signature, Title, Sections, Date Section Completed C","type":"text","repeats":false,"readOnly":false,"maxLength":100,"id":"item.6.item.0.item.2","description":"The patient should provide their signature, title, and date in the section marked 'C'."},{"linkId":"Section-48/Z0400D","prefix":"Z0400D","text":"Signature, Title, Sections, Date Section Completed D","type":"text","repeats":false,"readOnly":false,"maxLength":100,"id":"item.6.item.0.item.3","description":"The patient was required to provide their signature and title, fill out several sections, and note down the date they completed section D."},{"linkId":"Section-48/Z0400E","prefix":"Z0400E","text":"Signature, Title, Sections, Date Section Completed E","type":"text","repeats":false,"readOnly":false,"maxLength":100,"id":"item.6.item.0.item.4","description":"\"The patient is required to provide a signature, title, and complete various sections. They also need to provide the date on which the section E was completed.\""},{"linkId":"Section-48/Z0400F","prefix":"Z0400F","text":"Signature, Title, Sections, Date Section Completed F","type":"text","repeats":false,"readOnly":false,"maxLength":100,"id":"item.6.item.0.item.5","description":"The patient completed the sections of the form and signed it, indicating their title and date when they finished section F."},{"linkId":"Section-48/Z0400G","prefix":"Z0400G","text":"Signature, Title, Sections, Date Section Completed G","type":"text","repeats":false,"readOnly":false,"maxLength":100,"id":"item.6.item.0.item.6","description":"The patient needs to provide their signatu