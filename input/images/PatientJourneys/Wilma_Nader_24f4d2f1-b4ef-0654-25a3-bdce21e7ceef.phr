:false,"maxLength":8,"id":"item.2.item.6.item.15"},{"linkId":"Section-41/24Q","prefix":"24Q","text":"Comorbid Condition Q","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.16"},{"linkId":"Section-41/24R","prefix":"24R","text":"Comorbid Condition R","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.17"},{"linkId":"Section-41/24S","prefix":"24S","text":"Comorbid Condition S","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.18"},{"linkId":"Section-41/24T","prefix":"24T","text":"Comorbid Condition T","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.19"},{"linkId":"Section-41/24U","prefix":"24U","text":"Comorbid Condition U","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.20"},{"linkId":"Section-41/24V","prefix":"24V","text":"Comorbid Condition V","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.21"},{"linkId":"Section-41/24W","prefix":"24W","text":"Comorbid Condition W","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.22"},{"linkId":"Section-41/24X","prefix":"24X","text":"Comorbid Condition X","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.23"},{"linkId":"Section-41/24Y","prefix":"24Y","text":"Comorbid Condition Y","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.24"}],"id":"item.2.item.6"},{"linkId":"Section-41/21","prefix":"21","text":"Impairment group","type":"group","repeats":false,"readOnly":true,"item":[{"linkId":"Section-41/21_admission","prefix":"21_admission","text":"Impairment group - admission","type":"group","repeats":false,"readOnly":true,"id":"item.2.item.7.item.0"}],"id":"item.2.item.7"}],"id":"item.2","description":"The form is requesting the patient's medical information."},{"linkId":"Section-41/K0200A","prefix":"K0200A","text":"Height (in inches). Record most recent height measure since {admission}","type":"integer","repeats":false,"readOnly":false,"maxLength":2,"id":"item.2.item.0","description":"The form asks for the patient's height in inches and requests the most recent measurement since their admission."},{"linkId":"Section-41/K0200B","prefix":"K0200B","text":"Weight (in pounds). Base weight on most recent measure in last {specify time period in days}; measure weight consistently, according to standard {facility/setting} practice (e.g., in a.m. after voiding, before meal, with shoes off, etc.)","type":"integer","repeats":false,"readOnly":false,"maxLength":3,"id":"item.2.item.1","description":"The patient's weight, in pounds, should be based on the most recent measurement taken within the specified time period in days. It's important to measure the patient's weight consistently, adhering to the standard practice of the facility or setting. For instance, this could be done in the morning after voiding, before a meal, with shoes off, and so on."},{"linkId":"Section-41/21A","prefix":"21A","text":"Impairment Group - Admission: Condition requiring admission to rehabilitation; code according to Appendix A.","type":"text","repeats":false,"readOnly":false,"maxLength":9,"id":"item.2.item.2","description":"The impairment group on the admission form refers to the condition that required the patient's admission to rehabilitation, which should be coded according to Appendix A."},{"linkId":"Section-41/23","prefix":"23","text":"Date of Onset of Impairment","type":"open-choice","repeats":false,"readOnly":false,"id":"item.2.item.3","description":"When did the patient's impairment begin?"},{"linkId":"Section-41/24A1","prefix":"24A1","text":"Are there any arthritis conditions recorded in items {impairment group, etiologic diagnosis, or comorbid conditions} that meet all the regulatory requirements for {IRF} classification","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}],"id":"item.2.item.4","description":"Does the patient have any arthritis conditions recorded in the impairment group, etiologic diagnosis, or comorbid conditions that meet all the regulatory requirements for Inpatient Rehabilitation Facility (IRF) classification?"},{"linkId":"Section-41/22","prefix":"22","text":"Etiologic Diagnosis: (Use ICD codes to indicate the etiologic problem that led to the condition for which the {patient/resident} is receiving rehabilitation)","type":"group","repeats":false,"readOnly":true,"item":[{"linkId":"Section-41/22A","prefix":"22A","text":"Etiologic Diagnosis A","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.5.item.0"},{"linkId":"Section-41/22B","prefix":"22B","text":"Etiologic Diagnosis B","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.5.item.1"},{"linkId":"Section-41/22C","prefix":"22C","text":"Etiologic Diagnosis C","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.5.item.2"}],"id":"item.2.item.5","description":"The etiologic diagnosis requires the use of ICD codes to indicate the underlying problem that led to the condition for which the patient is receiving rehabilitation."},{"linkId":"Section-41/22A","prefix":"22A","text":"Etiologic Diagnosis A","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.5.item.0","description":"The form for the patient includes a section labeled \"Etiologic Diagnosis A\"."},{"linkId":"Section-41/22B","prefix":"22B","text":"Etiologic Diagnosis B","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.5.item.1","description":"The form for the patient includes a section labeled \"Etiologic Diagnosis B\"."},{"linkId":"Section-41/22C","prefix":"22C","text":"Etiologic Diagnosis C","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.5.item.2","description":"The form asks for the patient's etiologic diagnosis C."},{"linkId":"Section-41/24","prefix":"24","text":"Comorbid Conditions. Use ICD codes to enter comorbid medical conditions","type":"group","repeats":false,"readOnly":true,"item":[{"linkId":"Section-41/24A","prefix":"24A","text":"Comorbid Condition A","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.0"},{"linkId":"Section-41/24B","prefix":"24B","text":"Comorbid Condition B","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.1"},{"linkId":"Section-41/24C","prefix":"24C","text":"Comorbid Condition C","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.2"},{"linkId":"Section-41/24D","prefix":"24D","text":"Comorbid Condition D","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.3"},{"linkId":"Section-41/24E","prefix":"24E","text":"Comorbid Condition E","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.4"},{"linkId":"Section-41/24F","prefix":"24F","text":"Comorbid Condition F","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.5"},{"linkId":"Section-41/24G","prefix":"24G","text":"Comorbid Condition G","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.6"},{"linkId":"Section-41/24H","prefix":"24H","text":"Comorbid Condition H","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.7"},{"linkId":"Section-41/24I","prefix":"24I","text":"Comorbid Condition I","type":"text","repeats":false,"readOnly":false,"maxLength":8,"id":"item.2.item.6.item.8"},{"linkId":"Section-41/24J","prefix":"24J","text":"Comorbid Condition J","type":"text","repeats":false,