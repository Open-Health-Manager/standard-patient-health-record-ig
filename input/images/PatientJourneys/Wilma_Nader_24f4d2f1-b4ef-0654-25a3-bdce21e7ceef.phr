alueCoding":{"system":"http://del.cms.gov","code":"04","display":"Caregiver(s) currently provide assistance - {Patient's/Resident's} usual caregiver(s) willing and able to provide needed assistance."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30939-5","display":"Caregiver(s) currently provide assistance - Person's usual caregiver(s) willing and able to provide needed assistance."}},{"valueCoding":{"system":"http://del.cms.gov","code":"03","display":"Caregiver(s) need training/supportive services to provide assistance - Caregiver(s) available and need assistance to provide support."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30940-3","display":"Caregiver(s) need training/supportive services to provide assistance - Caregiver(s) available and need assistance to provide support."}},{"valueCoding":{"system":"http://del.cms.gov","code":"02","display":"Unclear is caregiver(s) will provide assistance - Caregiver(s) available in the home but it is not clear if caregiver(s) will provide needed assistance."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30941-1","display":"Unclear if caregiver(s) will provide assistance - Caregiver(s) available in the home but it is not clear if caregiver(s) will provide needed assistance."}},{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"Assistance needed but no caregiver(s) available - {Patient/Resident} needs assistance but no caregiver(s) available in the home."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30942-9","display":"Assistance needed but no caregiver(s) available - Person needs assistance but no caregiver(s) available in the home."}},{"valueCoding":{"system":"http://del.cms.gov","code":"00","display":"Assistance needed but {patient/resident} declines assistance - {Patient/Resident} needs caregiving but declines this assistance."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30943-7","display":"Assistance needed but person declines assistance - Person needs caregiving but declines this assistance."}},{"valueCoding":{"system":"http://del.cms.gov","code":"11","display":"Not applicable - {Patient/Resident} does not do this activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30944-5","display":"Not applicable - Person does not do this activity."}}]},{"linkId":"Section-6/F0920D2","prefix":"F0920D2","text":"Does the patient administer their medication themselves (for example, oral, inhaled, or injectable medications) without any paid assistance?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"05","display":"Assistance not needed - No assistance needed."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30938-7","display":"Assistance not needed - No assistance needed."}},{"valueCoding":{"system":"http://del.cms.gov","code":"04","display":"Caregiver(s) currently provide assistance - {Patient's/Resident's} usual caregiver(s) willing and able to provide needed assistance."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30939-5","display":"Caregiver(s) currently provide assistance - Person's usual caregiver(s) willing and able to provide needed assistance."}},{"valueCoding":{"system":"http://del.cms.gov","code":"03","display":"Caregiver(s) need training/supportive services to provide assistance - Caregiver(s) available and need assistance to provide support."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30940-3","display":"Caregiver(s) need training/supportive services to provide assistance - Caregiver(s) available and need assistance to provide support."}},{"valueCoding":{"system":"http://del.cms.gov","code":"02","display":"Unclear is caregiver(s) will provide assistance - Caregiver(s) available in the home but it is not clear if caregiver(s) will provide needed assistance."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30941-1","display":"Unclear if caregiver(s) will provide assistance - Caregiver(s) available in the home but it is not clear if caregiver(s) will provide needed assistance."}},{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"Assistance needed but no caregiver(s) available - {Patient/Resident} needs assistance but no caregiver(s) available in the home."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30942-9","display":"Assistance needed but no caregiver(s) available - Person needs assistance but no caregiver(s) available in the home."}},{"valueCoding":{"system":"http://del.cms.gov","code":"00","display":"Assistance needed but {patient/resident} declines assistance - {Patient/Resident} needs caregiving but declines this assistance."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30943-7","display":"Assistance needed but person declines assistance - Person needs caregiving but declines this assistance."}},{"valueCoding":{"system":"http://del.cms.gov","code":"11","display":"Not applicable - {Patient/Resident} does not do this activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30944-5","display":"Not applicable - Person does not do this activity."}}]},{"linkId":"Section-6/F0910B2","prefix":"F0910B2","text":"Please indicate the level of both paid and unpaid assistance in the patient's or resident's home during the past month. The level of assistance was unpaid.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"05","display":"No assistance received"}},{"valueCoding":{"system":"http://loinc.org","code":"LA12345-7","display":"No assistance received"}},{"valueCoding":{"system":"http://del.cms.gov","code":"04","display":"Occasional/short-term assistance"}},{"valueCoding":{"system":"http://loinc.org","code":"LA30934-6","display":"Occasional/short term assistance"}},{"valueCoding":{"system":"http://del.cms.gov","code":"03","display":"Regular night-time"}},{"valueCoding":{"system":"http://loinc.org","code":"LA30935-3","display":"Regular nigh