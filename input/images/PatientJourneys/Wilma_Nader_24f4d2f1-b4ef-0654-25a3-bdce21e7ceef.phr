stem":"http://del.cms.gov","code":"99","display":"Not Listed"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27349-2","display":"Not listed"}}],"id":"item.3.item.0.item.1","description":"The form for the patient includes a section titled \"Secondary Source.\""},{"linkId":"Section-2","code":[{"system":"http://loinc.org","code":"88522-8","display":"IRF-PAI v2.0 - Hearing, speech, and vision - admission [CMS Assessment]"}],"text":"Section B: Hearing, Speech, and Vision","type":"group","readOnly":true,"item":[{"linkId":"Section-2/BB0700","prefix":"BB0700","text":"Expression of Ideas and Wants (consider both verbal and non-verbal expression and excluding language barriers)","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Expresses complex messages without difficulty and with speech that is clear and easy to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9967-6","display":"Expresses complex messages without difficulty and with speech that is clear and easy to understand"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Exhibits some difficulty with expressing needs and ideas (e.g., some words or finishing thoughts) or speech is not clear"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9966-8","display":"Exhibits some difficulty with expressing needs and ideas (e.g., some words or finishing thoughts) or speech is not clear"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Frequently exhibits difficulty with expressing needs and ideas"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9972-6","display":"Frequently exhibits difficulty with expressing needs and ideas"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Rarely/Never expresses self or speech is very difficult to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11713-7","display":"Rarely/Never expresses self or speech is very difficult to understand"}}],"id":"item.4.item.0"},{"linkId":"Section-2/BB0800","prefix":"BB0800","text":"Understanding Verbal and Non-Verbal Content (with hearing aid or device, if used, and excluding language barriers)","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Understands: Clear comprehension without cues or repetitions"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10110-7","display":"Understands: clear comprehension without cues or repetitions"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Usually Understands: Understands most conversations, but misses some part/intent of message. Requires cues at times to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10113-1","display":"Usually understands: understands most conversations, but misses some part/intent of message. Requires cues at times to understand"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Sometimes Understands: Understands only basic conversations or simple, direct phrases. Frequently requires cues to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10083-6","display":"Sometimes understands: understands only basic conversations or simple, direct phrases. Frequently requires cues to understand"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Rarely/Never Understands"}},{"valueCoding":{"system":"http://loinc.org","code":"LA81-5","display":"Rarely/never understands"}}],"id":"item.4.item.1"}],"id":"item.4","description":"In Section B of the form, the patient's hearing, speech, and vision capabilities are assessed."},{"linkId":"Section-2/BB0700","prefix":"BB0700","text":"Expression of Ideas and Wants (consider both verbal and non-verbal expression and excluding language barriers)","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cm