ption":[{"valueCoding":{"system":"http://del.cms.gov","code":"06","display":"Independent - {Patient/Resident} completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://loinc.org","code":"LA9983-3","display":"Independent - Patient completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://del.cms.gov","code":"05","display":"Setup or clean-up assistance - Helper sets up or cleans up; {patient/resident} completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10073-7","display":"Setup or clean-up assistance - Helper sets up or cleans up; patient completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"04","display":"Supervision or touching assistance - Helper provides verbal cues and/or touching/steadying and/or contact guard assistance as {patient/resident} completes activity. Assistance may be provided throughout the activity or intermittently."}},{"valueCoding":{"system":"http://loinc.org","code":"LA28225-3","display":"Supervision or touching assistance - Helper provides verbal cues and/or touching/steadying and/or contact guard assistance as patient completes activity. Assistance may be provided throughout the activity or intermittently."}},{"valueCoding":{"system":"http://del.cms.gov","code":"03","display":"Partial/moderate assistance - Helper does LESS THAN HALF the effort. Helper lifts, holds or supports trunk or limbs, but provides less than half the effort."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10055-4","display":"Partial/moderate assistance - Helper does less than half the effort. Helper lifts, holds or supports trunk or limbs, but provides less than half the effort."}},{"valueCoding":{"system":"http://del.cms.gov","code":"02","display":"Substantial/maximal assistance - Helper does MORE THAN HALF the effort. Helper lifts or holds trunk or limbs and provides more than half the effort."}},{"valueCoding":{"system":"http://loinc.org","code":"LA11759-0","display":"Substantial/maximal assistance - Helper does more than half the effort. Helper lifts or holds trunk or limbs and provides more than half the effort."}},{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"Dependent - Helper does ALL of the effort. {Patient/Resident} does none of the effort to complete the activity. Or, the assistance of 2 or more helpers is required for the {patient/resident} to complete the activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA27665-1","display":"Dependent - Helper does all of the effort. Patient does none of the effort to complete the activity. Or, the assistance of 2 or more helpers is required for the patient to complete the activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"07","display":"{Patient/Resident} refused"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10058-8","display":"Patient refused"}},{"valueCoding":{"system":"http://del.cms.gov","code":"09","display":"Not applicable - Not attempted and the {patient/resident} did not perform this activity prior to the current illness, exacerbation, or injury."}},{"valueCoding":{"system":"http://loinc.org","code":"LA28226-1","display":"Not applicable - Not attempted and the patient did not perform this activity prior to the current illness, exacerbation, or injury."}},{"valueCoding":{"system":"http://del.cms.gov","code":"10","display":"Not attempted due to environmental limitations (e.g., lack of equipment, weather constraints)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28227-9","display":"Not attempted due to environmental limitations (e.g. lack of equipment, weather constraints)."}},{"valueCoding":{"system":"http://del.cms.gov","code":"88","display":"Not attempted due to medical condition or safety concerns"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26735-3","display":"Not attempted due to medical condition or safety concerns"}}]},{"linkId":"Section-37/GG0110","prefix":"GG0110","text":"Please indicate the devices and aids that the patient or resident had used prior to their current illness, exacerbation, or injury. Check all that apply.","type":"choice","repeats":true,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"A","display":"Manual wheelchair"}},{"valueCoding":{"system":"http://loinc.org","code":"LA18363-4","display":"Manual wheelchair"}},{"valueCoding":{"system":"http://del.cms.gov","code":"B","display":"Motorized wheelchair and/or scooter"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26730-4","display":"Motorized wheelchair or scooter"}},{"valueCoding":{"system":"http://del.cms.gov","code":"C","display":"Mechanical lift"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11549-5","display":"Mechanical lift"}},{"valueCoding":{"system":"http://del.cms.gov","code":"Z","display":"None of the above"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9-3","display":"None of the above"}}]}],"_id":"8n58FaQa3jtdGyAJH"}
{"id":"pbupcoBuWyD8N7qtY","responseType":"QuestionnaireResponse","status":"draft","authored":"2024-04-27T18:36:21.698Z","item":[{"linkId":"Section-36/A0500B","prefix":"A0500B","text":"What is the patient's middle initial?","type":"text","repeats":false,"readOnly":false,"maxLength":1},{"linkId":"Section-36/A0800","prefix":"A0800","text":"What is the patient's gender?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Male"}},{"valueCoding":{"system":"http://loinc.org","code":"LA2-8","display":"Male"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Female"}},{"valueCoding":{"system":"http://loinc.org","code":"LA3-6","display":"Female"}}]},{"linkId":"Section-36/A0500C","prefix":"A0500C","text":"What is the patient's last name?","type":"text","repeats":false,"readOnly":false,"maxLength":18},{"linkId":"Section-36/A0500A","prefix":"A0500A","text":"What is the patient's first name?","type":"text","repeats":false,"readOnly":false,"maxLength":12},{"linkId":"Section-36/A0600A","prefix":"A0600A","text":"What is the patient's Social Security Number?","type":"text","repeats":false,"readOnly":false,"maxLength":9},{"linkId":"Section-36/A0900","prefix":"A0900","text":"What is the patient's birth date?","type":"open-choice","repeats":false,"readOnly":false},{"linkId":"Section-36/A1100B","prefix":"A1100B","text":"What is the patient's preferred language?","type":"text","repeats":false,"readOnly":false,"maxLength":15},{"linkId":"Section-36/A0600B","prefix":"A0600B","text":"What is the patient's Medicare number?","type":"text","repeats":false,"readOnly":false,"maxLength":12},{"linkId":"Section-36/A0100B","prefix":"A0100B","text":"Does the patient have a CMS Certification Number (CCN)?","type":"text","repeats":false,"readOnly":false,"maxLength":12},{"linkId":"Section-36/A0500D","prefix":"A0500D","text":"The form for the patient asks for their suffix.","type":"text","repeats":false,"readOnly":false,"maxLength":3},{"linkId":"Section-36/A0100A","prefix":"A0100A","text":"What is the patient's National Provider Identifier (NPI)?","type":"text","repeats":false,"readOnly":false,"maxLength":10},{"linkId":"Section-3/C1610E1","prefix":"C1610E1","text":"The patient's alertness level is normal.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}]},{"linkId":"Section-37/GG0170Q1","prefix":"GG0170Q1","text":"Does the patient or resident use a wheelchair and/or scooter upon admission?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}]},{"linkId":"Section-13/M0300A1","prefix":"M0300A1","text":"How many Stage 1 pressure injuries does the patient have?","type":"integer","repeats":false,"readOnly":false,"maxLength":1},{"linkId":"Section-13/M0300D1","prefix":"M0300D1","text":"The patient has a certain number of stage 4 pressure ulcers.","type":"integer","repeats":false,"readOnly":false,"maxLength":1},{"linkId":"Section-36/A0200","prefix":"A0200","text":"The type of provider for the patient needs to be specified.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Long-Term Care Hospital"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28448-1","display":"Long-term care hospital "}}]},{"linkId":"Section-15/O0250B","prefix":"O0250B","text":"What is the date the patient received the influenza vaccine?","type":"open-choice","repeats":false,"readOnly":false},{"linkId":"Section-36/A0100C","prefix":"A0100C","text":"The patient's State Medicaid Facility or Provider Number is required.","type":"text","repeats":false,"readOnly":false,"maxLength":15},{"linkId":"Section-9/I0050","prefix":"I0050","text":"Please indicate the primary medical condition category for the patient or resident.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Acute Onset Respiratory Condition (e.g., aspiration and specified bacterial pneumonias)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27513-3","display":"Acute onset respiratory condition (e.g., aspiration and specified bacterial pneumonias)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Chronic Respiratory Condition (e.g., chronic obstructive pulmonary disease)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27514-1","display":"Chronic respiratory condition (e.g., chronic obstructive pulmonary disease)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Acute Onset and Chronic Respiratory Conditions"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27515-8","display":"Acute onset and chronic respiratory conditions"}},{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Chronic Cardiac Condition (e.g., heart failure)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27516-6","display":"Chronic cardiac condition (e.g., heart failure)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"5","display":"Other Medical Condition. If \"Other Medical Condition\", enter ICD code in the boxes."}},{"valueCoding":{"system":"http://loinc.org","code":"LA16346-1","display":"Other medical condition"}}]},{"linkId":"Section-37/GG0170RR1","prefix":"GG0170RR1","text":"The form asks the patient to indicate the type of wheelchair or scooter they use upon admission.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Manual"}},{"valueCoding":{"system":"http://loinc.org","code":"LA19016-7","display":"Manual"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Motorized"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26847-6","display":"Motorized"}}]},{"linkId":"Section-13/M0300B1","prefix":"M0300B1","text":"The patient has a certain number of Stage 2 pressure ulcers.","type":"integer","repeats":false,"readOnly":false,"maxLength":1},{"linkId":"Section-36/A0210","prefix":"A0210","text":"The assessment reference date refers to the patient's observation end date.","type":"open-choice","repeats":false,"readOnly":false},{"linkId":"Section-36/A1400","prefix":"A1400","text":"The patient needs to provide their payer information by checking all the boxes that apply.","type":"choice","repeats":true,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"A","display":"Medicare (traditional fee-for-service)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6259-1","display":"Medicare (traditional fee-for-service)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"B","display":"Medicare (managed care/Part C/Medicare Advantage)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27554-7","display":"Medicare (managed care/Part C/Medicare Advantage)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"C","display":"Medicaid (traditional fee-for-service)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6257-5","display":"Medicaid (traditional fee-for-service)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"D","display":"Medicaid (managed care)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27556-2","display":"Medicaid (managed care)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"E","display":"Workers' compensation"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6452-2","display":"Workers' compensation"}},{"valueCoding":{"system":"http://del.cms.gov","code":"F","display":"Title programs (e.g., Title III, V, or XX)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6398-7","display":"Title programs (e.g., Title III, V, or XX)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"G","display":"Other government (e.g., TRICARE, VA, etc.)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10049-7","display":"Other government (e.g., TRICARE, VA, etc.)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"H","display":"Private insurance/Medigap"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10061-2","display":"Private insurance/Medigap"}},{"valueCoding":{"system":"http://del.cms.gov","code":"I","display":"Private managed care"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27561-2","display":"Private managed care"}},{"valueCoding":{"system":"http://del.cms.gov","code":"J","display":"Self-pay"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6369-8","display":"Self-pay"}},{"valueCoding":{"system":"http://del.cms.gov","code":"K","display":"No payer source"}},{"valueCoding":{"system":"http://loinc.org","code":"LA18995-3","display":"No payor source"}},{"valueCoding":{"system":"http://del.cms.gov","code":"X","display":"Unknown"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4489-6","display":"Unknown"}},{"valueCoding":{"system":"http://del.cms.gov","code":"Y","display":"Other"}},{"valueCoding":{"system":"http://loinc.org","code":"LA46-8","display":"Other"}}]},{"linkId":"Section-15/O0100","prefix":"O0100","text":"Please check all of the following special treatments, procedures, and programs that were performed on the patient.","type":"choice","repeats":true,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"G","display":"Non-invasive Ventilator (BIPAP, CPAP)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27542-2","display":"Non-invasive ventilator (BIPAP, CPAP)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"H","display":"IV Medications"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27972-1","display":"IV medications, (if checked, please specify below)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"H2a","display":"Vasoactive medications (i.e., continuous infusions of vasopressors or inotropes)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28269-1","display":"Vasoactive medications (i.e., continuous infusions of vasopressors or inotropes)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"J","display":"Dialysis"}},{"valueCoding":{"system":"http://loinc.org","code":"LA7216-0","display":"Dialysis"}},{"valueCoding":{"system":"http://del.cms.gov","code":"N","display":"Total Parenteral Nutrition"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10101-6","display":"Total parenteral nutrition"}},{"valueCoding":{"system":"http://del.cms.gov","code":"Z","display":"None of the above"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9-3","display":"None of the above"}}]},{"linkId":"Section-36/A0250","prefix":"A0250","text":"What is the reason for the patient's assessment?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"Admission"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10922-5","display":"Admission"}},{"valueCoding":{"system":"http://del.cms.gov","code":"10","display":"Planned discharge"}},{"valueCoding":{"system":"http://loinc.org","code":"LA18067-1","display":"Planned discharge"}},{"valueCoding":{"system":"http://del.cms.gov","code":"11","display":"Unplanned discharge"}},{"valueCoding":{"system":"http://loinc.org","code":"LA18068-9","display":"Unplanned discharge"}},{"valueCoding":{"system":"http://del.cms.gov","code":"12","display":"Expired"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10325-1","display":"Expired"}}]},{"linkId":"Section-36/A0050","prefix":"A0050","text":"The type of record for the patient needs to be identified.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Add new assessment/record"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27573-7","display":"Add new assessment/record"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Modify existing record"}},{"valueCoding":{"system":"http://loinc.org","code":"LA12664-1","display":"Modify existing record"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Inactivate existing record"}},{"valueCoding":{"system":"http://loinc.org","code":"LA12665-8","display":"Inactivate existing record"}}]},{"linkId":"Section-19/Z0400C","prefix":"Z0400C","text":"The sections were completed and dated by the patient, who then signed and titled the form.","type":"text","repeats":false,"readOnly":false,"maxLength":100},{"linkId":"Section-13/M0300G1","prefix":"M0300G1","text":"The patient has a certain number of unstageable pressure injuries that are presenting as deep tissue injury.","type":"integer","repeats":false,"readOnly":false,"maxLength":1},{"linkId":"Section-36/A1802","prefix":"A1802","text":"Where was the patient immediately preceding this admission? Was the patient admitted from home, another healthcare facility, or somewhere else?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"Community residential setting (e.g., private home/apt., board/care, assisted living, group home, adult foster care)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11501-6","display":"Community residential setting (e.g., private home, assisted living, group home, adult foster care)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"02","display":"Long-term care facility (LTC)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA18066-3","display":"Long-term care facility"}},{"valueCoding":{"system":"http://del.cms.gov","code":"03","display":"Skilled Nursing Facility (SNF)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27338-5","display":"Skilled nursing facility (SNF)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"04","display":"Hospital emergency department"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11504-0","display":"Hospital emergency department"}},{"valueCoding":{"system":"http://del.cms.gov","code":"05","display":"Short-stay acute hospital (IPPS)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10078-6","display":"Short-stay acute hospital (IPPS)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"06","display":"Long-term care hospital (LTCH)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10000-0","display":"Long-term care hospital (LTCH)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"07","display":"Inpatient rehabilitation facility or unit (IRF)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27548-9","display":"Inpatient rehabilitation facility or unit (IRF)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"08","display":"Psychiatric hospital or unit"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10065-3","display":"Psychiatric hospital or unit"}},{"valueCoding":{"system":"http://del.cms.gov","code":"09","display":"Intellectually Disabled/Developmentally Disabled (ID/DD) facility"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28224-6","display":"Intellectually disabled/developmentally disabled (ID/DD) facility"}},{"valueCoding":{"system":"http://del.cms.gov","code":"10","display":"Hospice"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6216-1","display":"Hospice"}},{"valueCoding":{"system":"http://del.cms.gov","code":"99","display":"None of the above"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9-3","display":"None of the above"}}]},{"linkId":"Section-15/O0250A","prefix":"O0250A","text":"Did the patient receive the influenza vaccine in this facility for this year's influenza vaccination season?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}]},{"linkId":"Section-19/Z0400I","prefix":"Z0400I","text":"The patient must provide their signature, title, and the date on which they completed Section I of the form.","type":"text","repeats":false,"readOnly":false,"maxLength":100},{"linkId":"Section-19/Z0400D","prefix":"Z0400D","text":"The patient needs to provide their Signature, Title, and the Date they completed Section D.","type":"text","repeats":false,"readOnly":false,"maxLength":100},{"linkId":"Section-2/B0100","prefix":"B0100","text":"The patient is in a comatose state with no discernible consciousness, persisting in a vegetative state.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}]},{"linkId":"Section-8/H0350","prefix":"H0350","text":"Please select the one category that best describes the patient's bladder continence.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Always continent (no documented incontinence)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26833-6","display":"Always continent (no documented incontinence)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Stress incontinence only"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26736-1","display":"Stress incontinence only"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Incontinent less than daily (e.g., once or twice during the 3-day assessment period)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26834-4","display":"Incontinent less than daily (e.g., once or twice during the 3-day assessment period)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Incontinent daily (at least once a day)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9979-1","display":"Incontinent daily (at least once a day)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Always incontinent"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9934-6","display":"Always incontinent"}},{"valueCoding":{"system":"http://del.cms.gov","code":"5","display":"No urine output (e.g., renal failure)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26738-7","display":"No urine output (e.g., renal failure)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Not applicable (e.g., indwelling catheter)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11693-1","display":"Not applicable (e.g., indwelling catheter)"}}]},{"linkId":"Section-3/C1610A","prefix":"C1610A","text":"Is there evidence of an acute change in the patient's or resident's mental status from their baseline?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}]},{"linkId":"Section-14/N2001","prefix":"N2001","text":"Did a complete drug regimen review for the patient identify potential clinically significant medication issues?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No - No issues found during review"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27634-7","display":"No - No issues found during review"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes - Issues found during review"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27635-4","display":"Yes - Issues found during review"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Not applicable - {Patient/Resident} is not taking any medications"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27636-2","display":"NA - Patient is not taking any medications"}}]},{"linkId":"Section-2/BB0800","prefix":"BB0800","text":"Does the patient understand both verbal and non-verbal content with the use of their hearing aid or device, excluding any language barriers?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Understands: Clear comprehension without cues or repetitions"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10110-7","display":"Understands clear comprehension without cues or repetitions"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Usually Understands: Understands most conversations, but misses some part/intent of message. Requires cues at times to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10113-1","display":"Usually understands: understands most conversations, but misses some part/intent of message. Requires cues at times to understand"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Sometimes Understands: Understands only basic conversations or simple, direct phrases. Frequently requires cues to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10083-6","display":"Sometimes understands: understands only basic conversations or simple, direct phrases. Frequently requires cues to understand"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Rarely/Never Understands"}},{"valueCoding":{"system":"http://loinc.org","code":"LA81-5","display":"Rarely/never understands"}}]},{"linkId":"Section-2/BB0700","prefix":"BB0700","text":"Does the patient express their ideas and wants, considering both verbal and non-verbal expression and excluding language barriers?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Expresses complex messages without difficulty and with speech that is clear and easy to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9967-6","display":"Expresses complex messages without difficulty and with speech that is clear and easy to understand"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Exhibits some difficulty with expressing needs and ideas (e.g., some words or finishing thoughts) or speech is not clear"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9966-8","display":"Exhibits some difficulty with expressing needs and ideas (e.g., some words or finishing thoughts) or speech is not clear"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Frequently exhibits difficulty with expressing needs and ideas"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9972-6","display":"Frequently exhibits difficulty with expressing needs and ideas"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Rarely/Never expresses self or speech is very difficult to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11713-7","display":"Rarely/Never expresses self or speech is very difficult to understand"}}]},{"linkId":"Section-37/GG0170F2","prefix":"GG0170F2","text":"The discharge goal for the patient is to have the ability to get on and off a toilet or commode independently.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"06","display":"Independent - {Patient/Resident} completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://loinc.org","code":"LA9983-3","display":"Independent - Patient completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://del.cms.gov","code":"05","display":"Setup or clean-up assistance - Helper sets up or cleans up; {patient/resident} completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10073-7","display":"Setup or clean-up assistance - Helper sets up or cleans up; patient completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"04","display":"Supervision or touching assistance - Helper provides verbal cues and/or touching/steadying and/or contact guard assistance as {patient/resident} completes activity. Assistance may be provided throughout the activity or intermittently."}},{"valueCoding":{"system":"http://loinc.org","code":"LA28225-3","display":"Supervision or touching assistance - Helper provides verbal cues and/or touching/steadying and/or contact guard assistance as patient completes activity. Assistance may be provided throughout the activity or intermittently."}},{"valueCoding":{"system":"http://del.cms.gov","code":"03","display":"Partial/moderate assistance - Helper does LESS THAN HALF the effort. Helper lifts, holds or supports trunk or limbs, but provides less than half the effort."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10055-4","display":"Partial/moderate assistance - Helper does less than half the effort. Helper lifts, holds or supports trunk or limbs, but provides less than half the effort."}},{"valueCoding":{"system":"http://del.cms.gov","code":"02","display":"Substantial/maximal assistance - Helper does MORE THAN HALF the effort. Helper lifts or holds trunk or limbs and provides more than half the effort."}},{"valueCoding":{"system":"http://loinc.org","code":"LA11759-0","display":"Substantial/maximal assistance - Helper does more than half the effort. Helper lifts or holds trunk or limbs and provides more than half the effort."}},{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"Dependent - Helper does ALL of the effort. {Patient/Resident} does none of the effort to complete the activity. Or, the assistance of 2 or more helpers is required for the {patient/resident} to complete the activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA27665-1","display":"Dependent - Helper does all of the effort. Patient does none of the effort to complete the activity. Or, the assistance of 2 or more helpers is required for the patient to complete the activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"07","display":"{Patient/Resident} refused"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10058-8","display":"Patient refused"}},{"valueCoding":{"system":"http://del.cms.gov","code":"09","display":"Not applicable - Not attempted and the {patient/resident} did not perform this activity prior to the current illness, exacerbation, or injury."}},{"valueCoding":{"system":"http://loinc.org","code":"LA28226-1","display":"Not applicable - Not attempted and the patient did not perform this activity prior to the current illness, exacerbation, or injury."}},{"valueCoding":{"system":"http://del.cms.gov","code":"10","display":"Not attempted due to environmental limitations (e.g., lack of equipment, weather constraints)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28227-9","display":"Not attempted due to environmental limitations (e.g. lack of equipment, weather constraints)."}},{"valueCoding":{"system":"http://del.cms.gov","code":"88","display":"Not attempted due to medical condition or safety concerns"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26735-3","display":"Not attempted due to medical condition or safety concerns"}}]},{"linkId":"Section-37/GG0170F1","prefix":"GG0170F1","text":"The form asks about the patient's admission performance regarding their ability to transfer to and from a toilet or commode.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"06","display":"Independent - {Patient/Resident} completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://loinc.org","code":"LA9983-3","display":"Independent - Patient completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://del.cms.gov","code":"05","display":"Setup or clean-up assistance - Helper sets up or cleans up; {patient/resident} completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10073-7","display":"Setup or clean-up assistance - Helper sets up or cleans up; patient completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"04","display":"Supervision or touching assistance - Helper provides verbal cues and/or touching/steadying and/or contact guard assistance as {patient/resident} completes activity. Assistance may be provided throughout the activity or intermittently."}},{"valueCoding":{"system":"http://loinc.org","code":"LA28225-3","display":"Supervision or touching assistance - Helper provides verbal cues and/or touching/steadying and/or contact guard assistance as patient completes activity. Assistance may be provided throughout the activity or intermittently."}},{"valueCoding":{"system":"http://del.cms.gov","code":"03","display":"Partial/moderate assistance - Helper does LESS THAN HALF the effort. Helper lifts, holds or supports trunk or limbs, but provides less than half the effort."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10055-4","display":"Partial/moderate assistance - Helper does less than half the effort. Helper lifts, holds or supports trunk or limbs, but provides less than half the effort."}},{"valueCoding":{"system":"http://del.cms.gov","code":"02","display":"Substantial/maximal assistance - Helper does MORE THAN HALF the effort. Helper lifts or holds trunk or limbs and provides more than half the effort."}},{"valueCoding":{"system":"http://loinc.org","code":"LA11759-0","display":"Substantial/maximal assistance - Helper does more than half the effort. Helper lifts or holds trunk or limbs and provides more than half the effort."}},{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"Dependent - Helper does ALL of the effort. {Patient/Resident} does none of the effort to complete the activity. Or, the assistance of 2 or more helpers is required for the {patient/resident} to complete the activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA27665-1","display":"Dependent - Helper does all of the effort. Patient does none of the effort to complete the activity. Or, the assistance of 2 or more helpers is required for the patient to complete the activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"07","display":"{Patient/Resident} refused"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10058-8","display":"Patient refused"}},{"valueCoding":{"system":"http://del.cms.gov","code":"09","display":"Not applicable - Not attempted and the {patient/resident} did not perform this activity prior to the current illness, exacerbation, or injury."}},{"valueCoding":{"system":"http://loinc.org","code":"LA28226-1","display":"Not applicable - Not attempted and the patient did not perform this activity prior to the current illness, exacerbation, or injury."}},{"valueCoding":{"system":"http://del.cms.gov","code":"10","display":"Not attempted due to environmental limitations (e.g., lack of equipment, weather constraints)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28227-9","display":"Not attempted due to environmental limitations (e.g. lack of equipment, weather constraints)."}},{"valueCoding":{"system":"http://del.cms.gov","code":"88","display":"Not attempted due to medical condition or safety concerns"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26735-3","display":"Not attempted due to medical condition or safety concerns"}}]},{"linkId":"Section-36/A1200","prefix":"A1200","text":"What is the patient's marital status? Is the patient single, married, divorced, separated, or widowed?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Never married"}},{"valueCoding":{"system":"http://loinc.org","code":"LA47-6","display":"Never married"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Married"}},{"valueCoding":{"system":"http://loinc.org","code":"LA48-4","display":"Married"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Widowed"}},{"valueCoding":{"system":"http://loinc.org","code":"LA49-2","display":"Widowed"}},{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Separated"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4288-2","display":"Separated"}},{"valueCoding":{"system":"http://del.cms.gov","code":"5","display":"Divorced"}},{"valueCoding":{"system":"http://loinc.org","code":"LA51-8","display":"Divorced"}}]},{"linkId":"Section-37/GG0170B2","prefix":"GG0170B2","text":"The discharge goal for the patient is to have the ability to move from sitting on the side of the bed to lying flat on the bed.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"06","display":"Independent - {Patient/Resident} completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://loinc.org","code":"LA9983-3","display":"Independent - Patient completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://del.cms.gov","code":"05","display":"Setup or clean-up assistance - Helper sets up or cleans up; {patient/resident} completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10073-7","display":"Setup or clean-up assistance - Helper sets up or cleans up; patient completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"04","display":"Supervision or touching assistance - Helper provides verbal cues and/or touching/steadying and/or contact guard assistance as {patient/resident} completes activity. Assistance may be provided throughout the activity or intermittently."}},{"valueCoding":{"system":"http://loinc.org","code":"LA28225-3","display":"Supervision or touching assistance - Helper provides verbal cues and/or touching/steadying and/or contact guard assistance as patient completes activity. Assistance may be provided throughout the activity or intermittently."}},{"valueCoding":{"system":"http://del.cms.gov","code":"03","display":"Partial/moderate assistance - Helper does LESS THAN HALF the effort. Helper lifts, holds or supports trunk or limbs, but provides less than half the effort."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10055-4","display":"Partial/moderate assistance - Helper does less than half the effort. Helper lifts, holds or supports trunk or limbs, but provides less than half the effort."}},{"valueCoding":{"system":"http://del.cms.gov","code":"02","display":"Substantial/maximal assistance - Helper does MORE THAN HALF the effort. Helper lifts or holds trunk or limbs and provides more than half the effort."}},{"valueCoding":{"system":"http://loinc.org","code":"LA11759-0","display":"Substantial/maximal assistance - Helper does more than half the effort. Helper lifts or holds trunk or limbs and provides more than half the effort."}},{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"Dependent - Helper does ALL of the effort. {Patient/Resident} does none of the effort to complete the activity. Or, the assistance of 2 or more helpers is required for the {patient/resident} to complete the activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA27665-1","display":"Dependent - Helper does all of the effort. Patient does none of the effort to complete the activity. Or, the assistance of 2 or more helpers is required for the patient to complete the activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"07","display":"{Patient/Resident} refused"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10058-8","display":"Patient refused"}},{"valueCoding":{"system":"http://del.cms.gov","code":"09","display":"Not applicable - Not attempted and the {patient/resident} did not perform this activity prior to the current illness, exacerbation, or injury."}},{"valueCoding":{"system":"http://loinc.org","code":"LA28226-1","display":"Not applicable - Not attempted and the patient did not perform this activity prior to the current illness, exacerbation, or injury."}},{"valueCoding":{"system":"http://del.cms.gov","code":"10","display":"Not attempted due to environmental limitations (e.g., lack of equipment, weather constraints)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28227-9","display":"Not attempted due to environmental limitations (e.g. lack of equipment, weather constraints)."}},{"valueCoding":{"system":"http://del.cms.gov","code":"88","display":"Not attempted due to medical condition or safety concerns"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26735-3","display":"Not attempted due to medical condition or safety concerns"}}]},{"linkId":"Section-19/Z0500B","prefix":"Z0500B","text":"The date on which the Registered Nurse Assessment Coordinator signed the patient's assessment as complete.","type":"open-choice","repeats":false,"readOnly":false},{"linkId":"Section-15/O0150B","prefix":"O0150B","text":"The patient was assessed for readiness for spontaneous breathing trial (SBT) by the second day of their Long Term Care Hospital (LTCH) stay.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}]},{"linkId":"Section-13/M0210","prefix":"M0210","text":"Does this patient or resident have one or more unhealed pressure ulcers or injuries?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}]},{"linkId":"Section-19/Z0400F","prefix":"Z0400F","text":"The signature, title, and date of the section completed F were filled out by the patient.","type":"text","repeats":false,"readOnly":false,"maxLength":100},{"linkId":"Section-36/A1100A","prefix":"A1100A","text":"Does the patient need or want an interpreter to communicate with a doctor or health care staff? Please indicate 'yes' or 'no'.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Unable to determine"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11137-9","display":"Unable to determine"}}]},{"linkId":"Section-19/Z0400B","prefix":"Z0400B","text":"The patient completed section B and then they signed and dated the form, also providing their title.","type":"text","repeats":false,"readOnly":false,"maxLength":100},{"linkId":"Section-15/O0150A","prefix":"O0150A","text":"Was the patient on invasive mechanical ventilator support upon admission to the Long-Term Care Hospital?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No, not on invasive mechanical ventilation support upon admission"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28329-3","display":"No, not on invasive mechanical ventilation support"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes, weaning"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28330-1","display":"Yes, weaning"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Yes, non-weaning"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28331-9","display":"Yes, non-weaning"}}]},{"linkId":"Section-9/I0050A","prefix":"I0050A","text":"If the patient has an \"Other Medical Condition\", they should enter the ICD code in the provided boxes.","type":"text","repeats":false,"readOnly":false,"maxLength":8},{"linkId":"Section-13/M0300F1","prefix":"M0300F1","text":"How many unstageable pressure ulcers does the patient have due to the coverage of the wound bed by slough and/or eschar?","type":"integer","repeats":false,"readOnly":false,"maxLength":1},{"linkId":"Section-19/Z0400G","prefix":"Z0400G","text":"The patient's signature, title, and the date are required in the completed Section G.","type":"text","repeats":false,"readOnly":false,"maxLength":100},{"linkId":"Section-19/Z0400E","prefix":"Z0400E","text":"The form requires the patient's signature, title, the sections they completed, and the date on which Section E was completed.","type":"text","repeats":false,"readOnly":false,"maxLength":100},{"linkId":"Section-11/K0200A","prefix":"K0200A","text":"Please record the most recent measurement of the patient's height in inches since their admission.","type":"integer","repeats":false,"readOnly":false,"maxLength":2},{"linkId":"Section-36/A0220","prefix":"A0220","text":"The admission date of the patient is?","type":"open-choice","repeats":false,"readOnly":false},{"linkId":"Section-19/Z0500A","prefix":"Z0500A","text":"The form requires the patient's signature.","type":"text","repeats":false,"readOnly":false,"maxLength":100},{"linkId":"Section-8/H0400","prefix":"H0400","text":"Please select the one category that best describes the patient's or resident's bowel continence.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Always continent"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11042-1","display":"Always continent"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Occasionally incontinent (one episode of bowel incontinence)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11048-8","display":"Occasionally incontinent (one episode of bowel incontinence)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Frequently incontinent (2 or more episodes of bowel incontinence, but at least one continent bowel movement)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11049-6","display":"Frequently incontinent (2 or more episodes of bowel incontinence, but at least one continent bowel movement)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Always incontinent (no episodes of continent bowel movements)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11050-4","display":"Always incontinent (no episodes of continent bowel movements)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Not rated, {patient/resident} had an ostomy or did not have a bowel movement for the entire 3 days"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26835-1","display":"Not rated, patient had an ostomy or did not have a bowel movement for the entire 3 days"}}]},{"linkId":"Section-36/A1000","prefix":"A1000","text":"The patient should check all the applicable options for their race or ethnicity.","type":"choice","repeats":true,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"A","display":"American Indian or Alaska Native"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6155-1","display":"American Indian or Alaska Native"}},{"valueCoding":{"system":"http://del.cms.gov","code":"B","display":"Asian"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6156-9","display":"Asian"}},{"valueCoding":{"system":"http://del.cms.gov","code":"C","display":"Black or African American"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10610-6","display":"Black or African American"}},{"valueCoding":{"system":"http://del.cms.gov","code":"D","display":"Hispanic or Latino"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6214-6","display":"Hispanic or Latino"}},{"valueCoding":{"system":"http://del.cms.gov","code":"E","display":"Native Hawaiian or Other Pacific Islander"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10611-4","display":"Native Hawaiian or Other Pacific Islander"}},{"valueCoding":{"system":"http://del.cms.gov","code":"F","display":"White"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4457-3","display":"White"}}]},{"linkId":"Section-3/C1610B","prefix":"C1610B","text":"Did the patient's abnormal behavior fluctuate during the day, that is, did it tend to come and go or increase and decrease in severity?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}]},{"linkId":"Section-19/Z0400J","prefix":"Z0400J","text":"The patient needs to provide their signature and title in the designated sections and also indicate the date when each section was completed.","type":"text","repeats":false,"readOnly":false,"maxLength":100},{"linkId":"Section-37/GG0170J1","prefix":"GG0170J1","text":"The form asks if, once standing, the patient has the ability to walk at least 50 feet and make two turns for their admission performance.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"06","display":"Independent - {Patient/Resident} completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://loinc.org","code":"LA9983-3","display":"Independent - Patient completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://del.cms.gov","code":"05","display":"Setup or clean-up assistance - Helper sets up or cleans up; {patient/resident} completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10073-7","display":"Setup or clean-up assistance - Helper sets up or cleans up; patient completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"04","display":"Supervision or touching assistance - Helper provides verbal cues and/or touching/steadying and/or contact guard assistance as {patient/resident} completes activity. Assistance may be provided throughout the activity or intermittently."}},{"valueCoding":{"system":"http://loinc.org","code":"LA28225-3","display":"Supervision or touching assistance - Helper provides verbal cues and/or touching/steadying and/or contact guard assistance as patient completes activity. Assistance may be provided throughout the activity or intermittently."}},{"valueCoding":{"system":"http://del.cms.gov","code":"03","display":"Partial/moderate assistance - Helper does LESS THAN HALF the effort. Helper lifts, holds or supports trunk or limbs, but provides less than half the effort."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10055-4","display":"Partial/moderate assistance - Helper does less than half the effort. Helper lifts, holds or supports trunk or limbs, but provides less than half the effort."}},{"valueCoding":{"system":"http://del.cms.gov","code":"02","display":"Substantial/maximal assistance - Helper does MORE THAN HALF the effort. Helper lifts or holds trunk or limbs and provides more than half the effort."}},{"valueCoding":{"system":"http://loinc.org","code":"LA11759-0","display":"Substantial/maximal assistance - Helper does more than half the effort. Helper lifts or holds trunk or limbs and provides more than half the effort."}},{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"Dependent - Helper does ALL of the effort. {Patient/Resident} does none of the effort to complete the activity. Or, the assistance of 2 or more helpers is required for the {patient/resident} to complete the activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA27665-1","display":"Dependent - Helper does all of the effort. Patient does none of the effort to complete the activity. Or, the assistance of 2 or more helpers is required for the patient to complete the activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"07","display":"{Patient/Resident} refused"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10058-8","display":"Patient refused"}},{"valueCoding":{"system":"http://del.cms.gov","code":"09","display":"Not applicable - Not attempted and the {patient/resident} did not perform this activity prior to the current illness, exacerbation, or injury."}},{"valueCoding":{"system":"http://loinc.org","code":"LA28226-1","display":"Not applicable - Not attempted and the patient did not perform this activity prior to the current illness, exacerbation, or injury."}},{"valueCoding":{"system":"http://del.cms.gov","code":"10","display":"Not attempted due to environmental limitations (e.g., lack of equipment, weather constraints)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28227-9","display":"Not attempted due to environmental limitations (e.g. lack of equipment, weather constraints)."}},{"valueCoding":{"system":"http://del.cms.gov","code":"88","display":"Not attempted due to medical condition or safety concerns"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26735-3","display":"Not attempted due to medical condition or safety concerns"}}]},{"linkId":"Section-13/M0300C1","prefix":"M0300C1","text":"How many Stage 3 pressure ulcers does the patient have?","type":"integer","repeats":false,"readOnly":false,"maxLength":1},{"linkId":"Section-37/GG0170D1","prefix":"GG0170D1","text":"The form asks about the patient's admission performance regarding their ability to come to a standing position from sitting in a chair, wheelchair, or on the side of the bed.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"06","display":"Independent - {Patient/Resident} completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://loinc.org","code":"LA9983-3","display":"Independent - Patient completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://del.cms.gov","code":"05","display":"Setup or clean-up assistance - Helper sets up or cleans up; {patient/resident} completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"htt