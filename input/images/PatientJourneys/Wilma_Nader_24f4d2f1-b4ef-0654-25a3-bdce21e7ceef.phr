code":"LA26735-3","display":"Not attempted due to medical condition or safety concerns"}}]},{"linkId":"Section-9/I0000","prefix":"I0000","text":"Has the patient had any active diagnoses in the last 7 days? Please check all that apply. The diagnoses listed in parentheses are provided as examples and should not be considered as all-inclusive lists.","type":"choice","repeats":true,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"I0103","display":"Metastatic Cancer"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28289-9","display":"Metastatic cancer"}},{"valueCoding":{"system":"http://del.cms.gov","code":"I0104","display":"Severe Cancer"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28290-7","display":"Severe cancer"}},{"valueCoding":{"system":"http://del.cms.gov","code":"I0605","display":"Severe Left Systolic/Ventricular Dysfunction (known ejection fraction <= 30%)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28298-0","display":"Severe left systolic/ventricular dysfunction (known ejection fraction <= 30%)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"I0900","display":"Peripheral Vascular Disease (PVD) or Peripheral Arterial Disease (PAD)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA18399-8","display":"Peripheral vascular disease (PVD) or peripheral arterial disease (PAD)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"I1501","display":"Chronic Kidney Disease, Stage 5"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27518-2","display":"Chronic kidney disease, stage 5"}},{"valueCoding":{"system":"http://del.cms.gov","code":"I1502","display":"Acute Renal Failure"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27519-0","display":"Acute renal failure"}},{"valueCoding":{"system":"http://del.cms.gov","code":"I2101","display":"Septicemia, Sepsis, Systemic Inflammatory Response Syndrome/Shock"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27520-8","dis