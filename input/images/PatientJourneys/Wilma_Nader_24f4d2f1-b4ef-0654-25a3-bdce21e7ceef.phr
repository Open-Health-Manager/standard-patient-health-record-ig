239981","code":[{"system":"https://www.faa.gov/pilots/medical_certification","code":"5","display":"Address and telephone number"}],"text":"What is the patient's address and telephone number?","type":"string"},{"linkId":"990063069213","code":[{"system":"http://loinc.org","code":"21112-8","display":"Birth date"}],"text":"What is the patient's date of birth?","type":"string","required":true},{"linkId":"717842501763","code":[{"system":"https://www.faa.gov/pilots/medical_certification","code":"7","display":"Color of hair"}],"text":"What is the color of the patient's hair?","type":"string"},{"type":"choice","linkId":"8636877002143","code":[{"system":"https://www.faa.gov/pilots/medical_certification","code":"10","display":"Item 10 - Occupation"}],"text":"What is the patient's occupation?","answerOption":[{"valueCoding":{"system":"https://www.bls.gov/oes/current/oes_stru","code":"53-2011","display":"Airline Pilots, Copilots, and Flight Engineers"}},{"valueCoding":{"system":"https://www.bls.gov/oes/current/oes_stru","code":"53-2012","display":"Commercial Pilots"}}]},{"type":"string","linkId":"1408648142286","code":[{"system":"https://www.faa.gov/pilots/medical_certification","code":"12","display":"Item 12 - Employer name"}],"text":"What is the name of the patient's employer?"},{"type":"choice","linkId":"1835999511438","code":[{"system":"https://www.faa.gov/pilots/medical_certification","code":"13","display":"Item 13 - FAA Airman Medical Certificate Denied Suspended or Revoked"}],"text":"Has the patient's FAA Airman Medical Certificate ever been denied, suspended, or revoked?","required":true,"answerOption":[{"valueCoding":{"code":"1","display":"Yes"}},{"valueCoding":{"code":"0","display":"No"}}]},{"type":"choice","linkId":"2164571589013","code":[{"system":"https://www.faa.gov/pilots/medical_certification","code":"18","display":"Have you ever in your life been diagnosed with, had, or do you presently have any of the following?"}],"text":"Has the patient ever in their life been diagnosed with, had, or do they presently have any of the following?","required":true,"answerOption":[{"valueCoding":{"code":"a","display":"Frequent or severe headaches"}},{"valueCoding":{"code":"b","display":"Dizziness or fainting spell"}},{"valueCoding":{"code":"c","display":"Unconsciousness for any reason"}},{"valueCoding":{"code":"d","display":"Eye or vision trouble except glasses"}},{"valueCoding":{"code":"e","display":"Hay fever or allergy"}},{"valueCoding":{"code":"f","display":"Asthma or lung disease"}},{"valueCoding":{"code":"g","display":"Heart or vascular trouble"}},{"valueCoding":{"code":"h","display":"High or low blood pressure"}},{"valueCoding":{"code":"i","display":"Stomach, liver, or intestinal trouble"}},{"valueCoding":{"code":"j","display":"Kidney stone or blood in urine"}},{"valueCoding":{"code":"k","display":"Diabetes"}},{"valueCoding":{"code":"l","display":"Neurlogical disorders; epilepsy, seizures, stroke, paralysis, etc"}},{"valueCoding":{"code":"m","display":"Mental disorders of any sort; depression, anxiety, etc"}},{"valueCoding":{"code":"n","display":"Substance dependence or failed a drug test ever; or substance abuse or use of illegal substance in the last 2 years."}},{"valueCoding":{"code":"o","display":"Alcohol dependence or abuse"}},{"valueCoding":{"code":"p","display":"Suicide attempt"}},{"valueCoding":{"code":"q","display":"Motion sickness requiring medication"}}]},{"item":[{"text":"The applicant should indicate the total number of civilian flight hours and whether those hours are logged (LOG) or estimated (EST).","type":"display","linkId":"8884801232461_helpText","extension":[{"url":"http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl","valueCodeableConcept":{"text":"Help-Button","coding":[{"code":"help","display":"Help-Button","system":"http://hl7.org/fhir/questionnaire-item-control"}]}}]}],"type":"integer","extension":[{"url":"http://hl7.org/fhir/StructureDefinition/questionnaire-unit","valueCoding":{"system":"http: