stem":"http://del.cms.gov","code":"99","display":"Not Listed"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27349-2","display":"Not listed"}}],"id":"item.3.item.0.item.1","description":"The form for the patient includes a section titled \"Secondary Source.\""},{"linkId":"Section-2","code":[{"system":"http://loinc.org","code":"88522-8","display":"IRF-PAI v2.0 - Hearing, speech, and vision - admission [CMS Assessment]"}],"text":"Section B: Hearing, Speech, and Vision","type":"group","readOnly":true,"item":[{"linkId":"Section-2/BB0700","prefix":"BB0700","text":"Expression of Ideas and Wants (consider both verbal and non-verbal expression and excluding language barriers)","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Expresses complex messages without difficulty and with speech that is clear and easy to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9967-6","display":"Expresses complex messages without difficulty and with speech that is clear and easy to understand"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Exhibits some difficulty with expressing needs and ideas (e.g., some words or finishing thoughts) or speech is not clear"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9966-8","display":"Exhibits some difficulty with expressing needs and ideas (e.g., some words or finishing thoughts) or speech is not clear"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Frequently exhibits difficulty with expressing needs and ideas"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9972-6","display":"Frequently exhibits difficulty with expressing needs and ideas"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Rarely/Never expresses self or speech is very difficult to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11713-7","display":"Rarely/Never expresses self or speech is very difficult to understand"}}],"id":"item.4.item.0"},{"linkId":"Section-2/BB0800","prefix":"BB0800","text":"Understanding Verbal and Non-Verbal Content (with hearing aid or device, if used, and excluding language barriers)","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Understands: Clear comprehension without cues or repetitions"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10110-7","display":"Understands: clear comprehension without cues or repetitions"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Usually Understands: Understands most conversations, but misses some part/intent of message. Requires cues at times to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10113-1","display":"Usually understands: understands most conversations, but misses some part/intent of message. Requires cues at times to understand"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Sometimes Understands: Understands only basic conversations or simple, direct phrases. Frequently requires cues to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10083-6","display":"Sometimes understands: understands only basic conversations or simple, direct phrases. Frequently requires cues to understand"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Rarely/Never Understands"}},{"valueCoding":{"system":"http://loinc.org","code":"LA81-5","display":"Rarely/never understands"}}],"id":"item.4.item.1"}],"id":"item.4","description":"In Section B of the form, the patient's hearing, speech, and vision capabilities are assessed."},{"linkId":"Section-2/BB0700","prefix":"BB0700","text":"Expression of Ideas and Wants (consider both verbal and non-verbal expression and excluding language barriers)","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Expresses complex messages without difficulty and with speech that is clear and easy to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9967-6","display":"Expresses complex messages without difficulty and with speech that is clear and easy to understand"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Exhibits some difficulty with expressing needs and ideas (e.g., some words or finishing thoughts) or speech is not clear"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9966-8","display":"Exhibits some difficulty with expressing needs and ideas (e.g., some words or finishing thoughts) or speech is not clear"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Frequently exhibits difficulty with expressing needs and ideas"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9972-6","display":"Frequently exhibits difficulty with expressing needs and ideas"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Rarely/Never expresses self or speech is very difficult to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11713-7","display":"Rarely/Never expresses self or speech is very difficult to understand"}}],"id":"item.4.item.0","description":"The patient's expression of ideas and wants, considering both verbal and non-verbal expression and excluding language barriers, should be evaluated. Does the patient often communicate their ideas and desires clearly? The answer could be 'Always', 'Often', 'Sometimes', 'Rarely', or 'Never'."},{"linkId":"Section-2/BB0800","prefix":"BB0800","text":"Understanding Verbal and Non-Verbal Content (with hearing aid or device, if used, and excluding language barriers)","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Understands: Clear comprehension without cues or repetitions"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10110-7","display":"Understands: clear comprehension without cues or repetitions"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Usually Understands: Understands most conversations, but misses some part/intent of message. Requires cues at times to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10113-1","display":"Usually understands: understands most conversations, but misses some part/intent of message. Requires cues at times to understand"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Sometimes Understands: Understands only basic conversations or simple, direct phrases. Frequently requires cues to understand"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10083-6","display":"Sometimes understands: understands only basic conversations or simple, direct phrases. Frequently requires cues to understand"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Rarely/Never Understands"}},{"valueCoding":{"system":"http://loinc.org","code":"LA81-5","display":"Rarely/never understands"}}],"id":"item.4.item.1","description":"Does the patient understand both verbal and non-verbal content with the use of a hearing aid or device, if used, while excluding any language barriers?"},{"linkId":"Section-3","code":[{"system":"http://loinc.org","code":"88524-4","display":"IRF-PAI v2.0 - Cognitive patterns - admission [CMS Assessment]"}],"text":"Section C: Cognitive Patterns","type":"group","readOnly":true,"item":[{"linkId":"Section-3/C0100","prefix":"C0100","text":"Should Brief Interview for Mental Status be Conducted? Attempt to conduct interview with all {patients/residents}","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No ({patient/resident} is rarely/never understood)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27578-6","display":"No (patient is rarely/never understood)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}],"id":"item.5.item.0"},{"linkId":"Section-3/C0200","prefix":"C0200","text":"Repetition of Three Words - Ask {patient/resident}: \"I am going to say three words for you to remember. Please repeat the words after I have said all three. The words are: sock, blue, and bed. Now tell me the three words.\" Number of words repeated after first attempt","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Three"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6395-3","display":"Three"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Two"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6404-3","display":"Two"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"One"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6306-0","display":"One"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"None"}},{"valueCoding":{"system":"http://loinc.org","code":"LA137-2","display":"None"}}],"id":"item.5.item.1"},{"linkId":"Section-3/C0500","prefix":"C0500","text":"BIMS Summary Score. Add scores for {Brief Interview for Mental Status questions} and fill in total score (00-15). Enter 99 if the {patient/resident} was unable to complete the interview","type":"integer","repeats":false,"readOnly":false,"maxLength":2,"id":"item.5.item.2"},{"linkId":"Section-3/C0600","prefix":"C0600","text":"Should the Staff Assessment for Mental Status be Conducted?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No ({patient/resident} was able to complete Brief Interview for Mental Status)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26843-5","display":"No (patient was able to complete Brief Interview for Mental Status)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes ({patient/resident} was unable to complete Brief Interview for Mental Status)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26844-3","display":"Yes (patient was unable to complete Brief Interview for Mental Status)"}}],"id":"item.5.item.3"},{"linkId":"Section-3/C0300","prefix":"C0300","text":"BIMS: Temporal Orientation (orientation to year, month, and day)","type":"group","repeats":false,"readOnly":true,"item":[{"linkId":"Section-3/C0300A","prefix":"C0300A","text":"Ask {patient/resident}: \"Please tell me what year it is right now.\" Able to report correct year","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Correct"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9960-1","display":"Correct"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Missed by 1 year"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10008-3","display":"Missed by 1 year"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Missed by 2 - 5 years"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10966-2","display":"Missed by 2-5 years"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Missed by > 5 years or no answer"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10965-4","display":"Missed by > 5 years or no answer"}}],"id":"item.5.item.4.item.0"},{"linkId":"Section-3/C0300B","prefix":"C0300B","text":"Ask {patient/resident}: \"What month are we in right now?\" Able to report correct month","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Accurate within 5 days"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9927-0","display":"Accurate within 5 days"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Missed by 6 days to 1 month"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10010-9","display":"Missed by 6 days to 1 month"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Missed by > 1 month or no answer"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10969-6","display":"Missed by > 1 month or no answer"}}],"id":"item.5.item.4.item.1"},{"linkId":"Section-3/C0300C","prefix":"C0300C","text":"Ask {patient/resident}: \"What day of the week is today?\" Able to report correct day of the week","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Correct"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9960-1","display":"Correct"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Incorrect or no answer"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9981-7","display":"Incorrect or no answer"}}],"id":"item.5.item.4.item.2"}],"id":"item.5.item.4"},{"linkId":"Section-3/C0400","prefix":"C0400","text":"Recall. Ask {patient/resident}: \"Let's go back to an earlier question. What were those three words that I asked you to repeat?\" If unable to remember a word, give cue (something to wear; a color; a piece of furniture) for that word.","type":"group","repeats":false,"readOnly":true,"item":[{"linkId":"Section-3/C0400A","prefix":"C0400A","text":"Able to recall \"sock\"","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Yes, no cue required"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10134-7","display":"Yes, no cue required"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes, after cueing (\"something to wear\")"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10126-3","display":"Yes, after cueing (\"something to wear\")"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No - could not recall"}},{"valueCoding":{"sy