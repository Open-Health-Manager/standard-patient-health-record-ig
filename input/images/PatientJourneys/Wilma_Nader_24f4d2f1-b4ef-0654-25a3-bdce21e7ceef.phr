inc.org","code":"LA11541-2","display":"Dependent - A helper completed the activities for the patient."}},{"valueCoding":{"system":"http://del.cms.gov","code":"8","display":"Unknown"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4489-6","display":"Unknown"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Not Applicable"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4720-4","display":"Not applicable"}}],"id":"item.6.item.52.item.0","description":"Please code the patient's or resident's need for assistance with bathing, dressing, using the toilet, and eating prior to their current illness, exacerbation, or injury for the Self-Care section."},{"linkId":"Section-37/GG0100B","prefix":"GG0100B","text":"Indoor Mobility (Ambulation): Code the {patient's/resident's} need for assistance with walking from room to room (with or without a device such as cane, crutch, or walker) prior to the current illness, exacerbation, or injury.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Independent - {Patient/Resident} completed all the activities by themself, with or without an assistive device, with no assistance from a helper."}},{"valueCoding":{"system":"http://loinc.org","code":"LA11539-6","display":"Independent - Patient completed all the activities by themself, with or without an assistive device, with no assistance from a helper."}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Needed Some Help - {Patient/Resident} needed partial assistance from another person to complete any activities."}},{"valueCoding":{"system":"http://loinc.org","code":"LA26832-8","display":"Needed some help - Patient needed partial assistance from another person to complete activities."}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Dependent - A helper completed all the activities for the {patient/resident}."}},{"valueCoding":{"system":"http://loinc.org","code":"LA11541-2","display":"Dependent - A helper completed the activities for the patient."}},{"valueCoding":{"system":"http://del.cms.gov","code":"8","display":"Unknown"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4489-6","display":"Unknown"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Not Applicable"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4720-4","display":"Not applicable"}}],"id":"item.6.item.52.item.1","description":"The form requests the code for the patient's or resident's need for assistance with walking from room to room, with or without a device such as a cane, crutch, or walker, prior to the current illness, exacerbation, or injury to determine their level of indoor mobility and ambulation."},{"linkId":"Section-37/GG0100C","prefix":"GG0100C","text":"Stairs: Code the {patient's/resident's} need for assistance with internal or external stairs (with or without a device such as cane, crutch or walker) prior to the current illness, exacerbation, or injury.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Independent - {Patient/Resident} completed all the activities by themself, with or without an assistive device, with no assistance from a helper."}},{"valueCoding":{"system":"http://loinc.org","code":"LA11539-6","display":"Independent - Patient completed all the activities by themself, with or without an assistive device, with no assistance from a helper."}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Needed Some Help - {Patient/Resident} needed partial assistance from another person to complete any activities."}},{"valueCoding":{"system":"http://loinc.org","code":"LA26832-8","display":"Needed some help - Patient needed partial assistance from another person to complete activities."}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Dependent - A helper completed all the activities for the {patient/resident}."}},{"valueCoding":{"system":"http://loinc.org","code":"LA11541-2","display":"Dependent - A helper completed the activities for the patient."}},{"valueCoding":{"system":"http://del.cms.gov","code":"8","display":"Unknown"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4489-6","display":"Unknown"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Not Applicable"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4720-4","display":"Not applicable"}}],"id":"item.6.item.52.item.2","description":"The form asks to code the patient's or resident's need for assistance with internal or external stairs, with or without a device such as a cane, crutch, or walker, prior to the current illness, exacerbation, or injury."},{"linkId":"Section-37/GG0100D","prefix":"GG0100D","text":"Functional Cognition: Code the {patient's/resident's} need for assistance with planning regular tasks, such as shopping or remembering to take medication prior to the current illness, exacerbation, or injury.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Independent - {Patient/Resident} completed all the activities by themself, with or without an assistive device, with no assistance from a helper."}},{"valueCoding":{"system":"http://loinc.org","code":"LA11539-6","display":"Independent - Patient completed all the activities by themself, with or without an assistive device, with no assistance from a helper."}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Needed Some Help - {Patient/Resident} needed partial assistance from another person to complete any activities."}},{"valueCoding":{"system":"http://loinc.org","code":"LA26832-8","display":"Needed some help - Patient needed partial assistance from another person to complete activities."}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Dependent - A helper completed all the activities for the {patient/resident}."}},{"valueCoding":{"system":"http://loinc.org","code":"LA11541-2","display":"Dependent - A helper completed the activities for the patient."}},{"valueCoding":{"system":"http://del.cms.gov","code":"8","display":"Unknown"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4489-6","display":"Unknown"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Not Applicable"}},{"valueCoding":{"system":"http://loinc.org","code":"LA4720-4","display":"Not applicable"}}],"id":"item.6.item.52.item.3","description":"The form asks to code the patient's or resident's need for assistance with planning regular tasks, such as shopping or remembering to take medication, prior to their current illness, exacerbation, or injury."},{"linkId":"Section-37/GG0130","prefix":"GG0130","text":"Self-Care.","type":"group","repeats":false,"readOnly":true,"item":[{"linkId":"Section-37/GG0130_1","prefix":"GG0130_1","text":"Self-Care. Code the {patient's/resident's} usual performance at {admission} for each activity using the 6-point scale. If activity was not attempted at {admission}, code the reason.","type":"group","repeats":false,"readOnly":true,"id":"item.6.item.53.item.0"},{"linkId":"Section-37/GG0130_2","prefix":"GG0130_2","text":"Self-Care. Code the {patient's/resident's} {discharge} goal(s) using the 6-point scale. Use of codes 07, 09, 10, or 88 is permissible to code {discharge} goal(s).","type":"group","repeats":false,"readOnly":true,"id":"item.6.item.53.item.1"}],"id":"item.6.item.53","description":"The patient is capable of self-care."},{"linkId":"Section-37/GG0130_1","prefix":"GG0130_1","text":"Self-Care. Code the {patient's/resident's} usual performance at {admission} for each activity using the 6-point scale. If activity was not attempted at {admission}, code the reason.","type":"group","repeats":false,"readOnly":true,"id":"item.6.item.53.item.0","description":"For the category of Self-Care, please code the patient's usual performance at the time of admission for each activity using the 6-point scale. If the activity was not attempted at the time of admission, please code the reason."},{"linkId":"Section-37/GG0130_2","prefix":"GG0130_2","text":"Self-Care. Code the {patient's/resident's} {discharge} goal(s) using the 6-point scale. Use of codes 07, 09, 10, or 88 is permissible to code {discharge} goal(s).","type":"group","repeats":false,"readOnly":true,"id":"item.6.item.53.item.1","description":"Please code the patient's or resident's self-care discharge goals using the 6-point scale. The use of codes 07, 09, 10, or 88 is permissible to code the discharge goals."},{"linkId":"Section-37/GG0170","prefix":"GG0170","text":"Mobility.","type":"group","repeats":false,"readOnly":true,"item":[{"linkId":"Section-37/GG0170_1","prefix":"GG0170_1","text":"Mobility. Code the {patient's/resident's} usual performance at {admission} for each activity using the 6-point scale. If activity was not attempted at {admission}, code the reason.","type":"group","repeats":false,"readOnly":true,"id":"item.6.item.54.item.0"},{"linkId":"Section-37/GG0170_2","prefix":"GG0170_2","text":"Mobility. Code the {patient's/resident's} {discharge} goal(s) using the 6-point scale. Use of codes 07, 09, 10, or 88 is permissible to code {discharge} goal(s).","type":"group","repeats":false,"readOnly":true,"id":"item.6.item.54.item.1"}],"id":"item.6.item.54","description":"The patient's mobility status is being assessed."},{"linkId":"Section-37/GG0170_1","prefix":"GG0170_1","text":"Mobility. Code the {patient's/resident's} usual performance at {admission} for each activity using the 6-point scale. If activity was not attempted at {admission}, code the reason.","type":"group","repeats":false,"readOnly":true,"id":"item.6.item.54.item.0","description":"For the section on mobility, please code the patient's or resident's usual performance at the time of admission for each activity using the 6-point scale. If a certain activity was not attempted at the time of admission, code the reason."},{"linkId":"Section-37/GG0170_2","prefix":"GG0170_2","text":"Mobility. Code the {patient's/resident's} {discharge} goal(s) using the 6-point scale. Use of codes 07, 09, 10, or 88 is permissible to code {discharge} goal(s).","type":"group","repeats":false,"readOnly":true,"id":"item.6.item.54.item.1","description":"The form instructs the user to code the patient's or resident's discharge goals using the 6-point scale. The use of codes 07, 09, 10, or 88 is permissible to code the discharge goals."},{"linkId":"Section-37/GG0110","prefix":"GG0110","text":"Prior Device Use. Indicate devices and aids used by the {patient/resident} prior to the current illness, exacerbation, or injury: Check all that apply","type":"choice","repeats":true,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"A","display":"Manual wheelchair"}},{"valueCoding":{"system":"http://loinc.org","code":"LA18363-4","display":"Manual wheelchair"}},{"valueCoding":{"system":"http://del.cms.gov","code":"B","display":"Motorized wheelchair and/or scooter"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26730-4","display":"Motorized wheelchair and/or scooter"}},{"valueCoding":{"system":"http://del.cms.gov","code":"C","display":"Mechanical lift"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11549-5","display":"Mechanical lift"}},{"valueCoding":{"system":"http://del.cms.gov","code":"D","display":"Walker"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10117-2","display":"Walker"}},{"valueCoding":{"system":"http://del.cms.gov","code":"E","display":"Orthotics/Prosthetics"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10046-3","display":"Orthotics/Prosthetics"}},{"valueCoding":{"system":"http://del.cms.gov","code":"Z","display":"None of the above"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9-3","display":"None of the above"}}],"id":"item.6.item.55","description":"Please indicate the devices and aids that the patient or resident used prior to their current illness, exacerbation, or injury. Check all that apply."},{"linkId":"Section-8","code":[{"system":"http://loinc.org","code":"83237-8","display":"Bladder and bowel [CMS Assessment]"}],"text":"Section H: Bladder and Bowel","type":"group","readOnly":true,"item":[{"linkId":"Section-8/H0400","prefix":"H0400","text":"Bowel Continence - Select the one category that best describes the {patient/resident}.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Always continent"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11042-1","display":"Always continent"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Occasionally incontinent (one episode of bowel incontinence)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11048-8","display":"Occasionally incontinent (one episode of bowel incontinence)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Frequently incontinent (2 or more episodes of bowel incontinence, but at least one continent bowel movement)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11049-6","display":"Frequently incontinent (2 or more episodes of bowel incontinence, but at least one continent bowel movement)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Always incontinent (no episodes of continent bowel movements)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11050-4","display":"Always incontinent (no episodes of continent bowel movements)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Not rated, {patient/resident} had an ostomy or did not have a bowel movement for the entire 3 days"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26835-1","display":"Not rated, patient had an ostomy or did not have a bowel movement for the entire 3 days"}}],"id":"item.7.item.0"},{"linkId":"Section-8/H0350","prefix":"H0350","text":"Bladder Continence - Select the one category that best describes the {patient/resident}.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Always continent (no documented incontinence)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26833-6","display":"Always continent (no documented incontinence)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Stress incontinence only"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26736-1","display":"Stress incontinence only"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Incontinent less than daily (e.g., once or twice during the 3-day assessment period)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26834-4","display":"Incontinent less than daily (e.g., once or twice during the 3-day assessment period)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Incontinent daily (at least once a day)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9979-1","display":"Incontinent daily (at least once a day)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Always incontinent"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9934-6","display":"Always incontinent"}},{"valueCoding":{"system":"http://del.cms.gov","code":"5","display":"No urine output (e.g., renal failure)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26738-7","display":"No urine output (e.g., renal failure)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Not applicable (e.g., indwelling catheter)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11693-1","display":"Not applicable (e.g., indwelling catheter)"}}],"id":"item.7.item.1"}],"id":"item.7","description":"In section H of the form, the patient's bladder and bowel conditions are addressed."},{"linkId":"Sectio