.org","code":"LA26735-3","display":"Not attempted due to medical condition or safety concerns"}}]},{"linkId":"Section-3/C1610C","prefix":"C1610C","text":"Did the patient have difficulty focusing attention, for example, being easily distractible or having difficulty keeping track of what was being said? The possible answers could be 'Yes', 'No', or 'Sometimes'.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}]},{"linkId":"Section-15/O0150D","prefix":"O0150D","text":"Is there documentation of the reason or reasons in the patient's or resident's medical record that indicates why the patient or resident was deemed medically unready for SBT by the second day of their stay at the Long-Term Care Hospital?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}}]},{"linkId":"Section-37/GG0130D2","prefix":"GG0130D2","text":"The discharge goal for the patient is to have the ability to wash, rinse, and dry their face, hands, chest, and arms while sitting in a chair or bed.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"06","display":"Independent - {Patient/Resident} completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://loinc.org","code":"LA9983-3","display":"Independent - Patient completes the activity by him/herself with no assis