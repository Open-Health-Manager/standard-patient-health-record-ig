due to short-term medical condition or safety concerns."}}]},{"linkId":"Section-37/GG0125C","prefix":"GG0125C","text":"Does the patient use an assistive device such as a wheelchair?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"02","display":"Assistive device needed and available - {Patient/Resident} needs this device to complete daily activities and has the device in the home."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30918-9","display":"Assistive device needed and available - Person needs this device to complete daily activities and has the device in the home."}},{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"Assistive device needed but current device unsuitable - Device is in home but no longer meets {patient's/resident's} needs."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30919-7","display":"Assistive device needed but current device unsuitable - Device is in home but no longer meets person's needs."}},{"valueCoding":{"system":"http://del.cms.gov","code":"00","display":"Assistive device needed but not available - {Patient/Resident} needs the device but it is not available in the home."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30920-5","display":"Assistive device needed but not available - Person needs the device but it is not available in the home."}},{"valueCoding":{"system":"http://del.cms.gov","code":"07","display":"{Patient/Resident} refused - {Patient/Resident} chooses not to use needed device."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30921-3","display":"Person refused - Person chooses to not use needed device."}},{"valueCoding":{"system":"http://del.cms.gov","code":"11","display":"Not applicable - {Patient/Resident} does not need this device."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30922-1","display":"Not applicable - Person does not need this device."}}]},{"linkId":"Section-37/GG0185H7"