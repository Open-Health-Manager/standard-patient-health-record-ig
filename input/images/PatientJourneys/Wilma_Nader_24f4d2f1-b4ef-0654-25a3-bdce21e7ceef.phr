{"responseType":"QuestionnaireResponse","questionnaire":"HIS-HD-2.00.0","id":"HIS-HD-2.00.0-1","title":"Hospice Item Set - Hospice Discharge Record","description":"The HIS is a standardized set of items intended to capture patient-level data on each hospice patient admission. HIS items can be used to calculate seven National Quality Forum (NQF) - endorsed measures, and two non-NQF endorsed measures.","status":"draft","authored":"2024-09-20T06:33:39.936Z","item":[{"linkId":"Section-36","text":"Section A: Administrative Information","type":"group","readOnly":true,"item":[{"linkId":"Section-36/A0700","prefix":"A0700","text":"Medicaid Number - Enter \"+\" if pending, \"N\" if not a Medicaid recipient","type":"text","repeats":false,"readOnly":false,"maxLength":14,"id":"item.0.item.0"},{"linkId":"Section-36/A0800","prefix":"A0800","text":"Gender","type":"text","repeats":false,"readOnly":false,"maxLength":1,"id":"item.0.item.1"},{"linkId":"Section-36/A0900","prefix":"A0900","text":"Birth Date","type":"open-choice","repeats":false,"readOnly":false,"id":"item.0.item.2"},{"linkId":"Section-36/A0050","prefix":"A0050","text":"Type of Record","type":"text","repeats":false,"readOnly":false,"maxLength":1,"id":"item.0.item.3"},{"linkId":"Section-36/A0250","prefix":"A0250","text":"Reason for Assessment","type":"text","repeats":false,"readOnly":false,"maxLength":2,"id":"item.0.item.4"},{"linkId":"Section-36/A0220","prefix":"A0220","text":"Admission Date","type":"open-choice","repeats":false,"readOnly":false,"id":"item.0.item.5"},{"linkId":"Section-36/A0270","prefix":"A0270","text":"Discharge Date","type":"open-choice","repeats":false,"readOnly":false,"id":"item.0.item.6"},{"linkId":"Section-36/A0100","prefix":"A0100","text":"Facility Provider Numbers","type":"group","repeats":false,"readOnly":true,"item":[{"linkId":"Section-36/A0100A","prefix":"A0100A","text":"National Provider Identifier (NPI)","type":"text","repeats":false,"readOnly":false,"maxLength":10,"id":"item.0.item.7.item.0"