cms.gov","code":"03","display":"Caregiver(s) need training/supportive services to provide assistance - Caregiver(s) available and need assistance to provide support."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30940-3","display":"Caregiver(s) need training/supportive services to provide assistance - Caregiver(s) available and need assistance to provide support."}},{"valueCoding":{"system":"http://del.cms.gov","code":"02","display":"Unclear is caregiver(s) will provide assistance - Caregiver(s) available in the home but it is not clear if caregiver(s) will provide needed assistance."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30941-1","display":"Unclear if caregiver(s) will provide assistance - Caregiver(s) available in the home but it is not clear if caregiver(s) will provide needed assistance."}},{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"Assistance needed but no caregiver(s) available - {Patient/Resident} needs assistance but no caregiver(s) available in the home."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30942-9","display":"Assistance needed but no caregiver(s) available - Person needs assistance but no caregiver(s) available in the home."}},{"valueCoding":{"system":"http://del.cms.gov","code":"00","display":"Assistance needed but {patient/resident} declines assistance - {Patient/Resident} needs caregiving but declines this assistance."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30943-7","display":"Assistance needed but person declines assistance - Person needs caregiving but declines this assistance."}},{"valueCoding":{"system":"http://del.cms.gov","code":"11","display":"Not applicable - {Patient/Resident} does not do this activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30944-5","display":"Not applicable - Person does not do this activity."}}]},{"linkId":"Section-37/GG0125O","prefix":"GG0125O","text":"Does the patient use an assistive device such as a walk-in or wheel-in shower?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"02","display":"Assistive device needed and available - {Patient/Resident} needs this device to complete daily activities and has the device in the home."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30918-9","display":"Assistive device needed and available - Person needs this device to complete daily activities and has the device in the home."}},{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"Assistive device needed but current device unsuitable - Device is in home but no longer meets {patient's/resident's} needs."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30919-7","display":"Assistive device needed but current device unsuitable - Device is in home but no longer meets person's needs."}},{"valueCoding":{"system":"http://del.cms.gov","code":"00","display":"Assistive device needed but not available - {Patient/Resident} needs the device but it is not available in the home."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30920-5","display":"Assistive device needed but not available - Person needs the device but it is not available in the home."}},{"valueCoding":{"system":"http://del.cms.gov","code":"07","display":"{Patient/Resident} refused - {Patient/Resident} chooses not to use needed device."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30921-3","display":"Person refused - Person chooses to not use needed device."}},{"valueCoding":{"system":"http://del.cms.gov","code":"11","display":"Not applicable - {Patient/Resident} does not need this device."}},{"valueCoding":{"system":"http://loinc.org","code":"LA30922-1","display":"Not applicable - Person does not need this device."}}]},{"linkId":"Section-37/GG0125B3","prefix":"GG0125B3","text":"Does the patient use an assistive device, specifically a walker with wheels?","type":"choice","repeats":false,"readOnly":false,"answerOpti