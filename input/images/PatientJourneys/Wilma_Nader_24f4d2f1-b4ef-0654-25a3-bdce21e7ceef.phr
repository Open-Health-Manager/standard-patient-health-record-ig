ption":[{"valueCoding":{"system":"http://del.cms.gov","code":"06","display":"Independent - {Patient/Resident} completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://loinc.org","code":"LA9983-3","display":"Independent - Patient completes the activity by him/herself with no assistance from a helper."}},{"valueCoding":{"system":"http://del.cms.gov","code":"05","display":"Setup or clean-up assistance - Helper sets up or cleans up; {patient/resident} completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10073-7","display":"Setup or clean-up assistance - Helper sets up or cleans up; patient completes activity. Helper assists only prior to or following the activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"04","display":"Supervision or touching assistance - Helper provides verbal cues and/or touching/steadying and/or contact guard assistance as {patient/resident} completes activity. Assistance may be provided throughout the activity or intermittently."}},{"valueCoding":{"system":"http://loinc.org","code":"LA28225-3","display":"Supervision or touching assistance - Helper provides verbal cues and/or touching/steadying and/or contact guard assistance as patient completes activity. Assistance may be provided throughout the activity or intermittently."}},{"valueCoding":{"system":"http://del.cms.gov","code":"03","display":"Partial/moderate assistance - Helper does LESS THAN HALF the effort. Helper lifts, holds or supports trunk or limbs, but provides less than half the effort."}},{"valueCoding":{"system":"http://loinc.org","code":"LA10055-4","display":"Partial/moderate assistance - Helper does less than half the effort. Helper lifts, holds or supports trunk or limbs, but provides less than half the effort."}},{"valueCoding":{"system":"http://del.cms.gov","code":"02","display":"Substantial/maximal assistance - Helper does MORE THAN HALF the effort. Helper lifts or holds trunk or limbs and provides more than half the effort."}},{"valueCoding":{"system":"http://loinc.org","code":"LA11759-0","display":"Substantial/maximal assistance - Helper does more than half the effort. Helper lifts or holds trunk or limbs and provides more than half the effort."}},{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"Dependent - Helper does ALL of the effort. {Patient/Resident} does none of the effort to complete the activity. Or, the assistance of 2 or more helpers is required for the {patient/resident} to complete the activity."}},{"valueCoding":{"system":"http://loinc.org","code":"LA27665-1","display":"Dependent - Helper does all of the effort. Patient does none of the effort to complete the activity. Or, the assistance of 2 or more helpers is required for the patient to complete the activity."}},{"valueCoding":{"system":"http://del.cms.gov","code":"07","display":"{Patient/Resident} refused"}},{"valueCoding":{"system":"http://loinc.org","code":"LA10058-8","display":"Patient refused"}},{"valueCoding":{"system":"http://del.cms.gov","code":"09","display":"Not applicable - Not attempted and the {patient/resident} did not perform this activity prior to the current illness, exacerbation, or injury."}},{"valueCoding":{"system":"http://loinc.org","code":"LA28226-1","display":"Not applicable - Not attempted and the patient did not perform this activity prior to the current illness, exacerbation, or injury."}},{"valueCoding":{"system":"http://del.cms.gov","code":"10","display":"Not attempted due to environmental limitations (e.g., lack of equipment, weather constraints)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA28227-9","display":"Not attempted due to environmental limitations (e.g. lack of equipment, weather constraints)."}},{"valueCoding":{"system":"http://del.cms.gov","code":"88","display":"Not attempted due to medical condition or safety concerns"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26735-3","display":"Not attempted due to medical condition or safety concerns"}}]},{"linkId":"Section-37/GG0110","prefix":"GG0110","text":"Please indicate the devices and aids that the patient or resident had used prior to their current illness, exacerbation, or injury. Check all that apply.","type":"choice","repeats":true,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"A","display":"Manual wheelchair"}},{"valueCoding":{"system":"http://loinc.org","code":"LA18363-4","display":"Manual wheelchair"}},{"valueCoding":{"system":"http://del.cms.gov","code":"B","display":"Motorized wheelchair and/or scooter"}},{"valueCoding":{"system":"http://loinc.org","code":"LA26730-4","display":"Motorized wheelchair or scooter"}},{"valueCoding":{"system":"http://del.cms.gov","code":"C","display":"Mechanical lift"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11549-5","display":"Mechanical lift"}},{"valueCoding":{"system":"http://del.cms.gov","code":"Z","display":"None of the above"}},{"valueCoding":{"system":"http://loinc.org","code":"LA9-3","display":"None of the above"}}]}],"_id":"ojFj9qnNgwEAASXHG"}
{"responseType":"QuestionnaireResponse","id":"OASIS-DAH-D1-012020","questionnaire":"OASIS-DAH-D1-012020","title":"Outcome and Assessment Information Set - Death at Home","description":"Data set for use in home health agencies (HHAs), State agencies, software vendors, professional associations and other Federal agencies in implementing and maintaining OASIS.","status":"draft","authored":"2024-04-27T18:41:02.853Z","item":[{"linkId":"Section-21/M0080","prefix":"M0080","text":"The discipline of the person who is completing the assessment for the patient is required.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"01","display":"RN"}},{"valueCoding":{"system":"http://del.cms.gov","code":"02","display":"PT"}},{"valueCoding":{"system":"http://del.cms.gov","code":"03","display":"SLP/ST"}},{"valueCoding":{"system":"http://del.cms.gov","code":"04","display":"OT"}}]},{"linkId":"Section-21/M0090","prefix":"M0090","text":"The date the assessment was completed for the patient.","type":"open-choice","repeats":false,"readOnly":false},{"linkId":"Section-21/M0100_","prefix":"M0100_","text":"This assessment is currently being completed for the following reason pertaining to the patient.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://loinc.org","code":"LA6390-4","display":"Start of care - further visits planned"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6366-4","display":"Resumption of care (after inpatient stay)"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6355-7","display":"Recertification (follow-up) reassessment"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6312-8","display":"Other follow-up"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6402-7","display":"Transferred to an inpatient facility - patient not discharged from agency"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6401-9","display":"Transferred to an inpatient facility - patient discharged from agency"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6179-1","display":"Death at home"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6184-1","display":"Discharge from agency"}}]},{"linkId":"Section-20/A0100A","prefix":"A0100A","text":"Does the patient have a National Provider Identifier (NPI)?","type":"text","repeats":false,"readOnly":false,"maxLength":10},{"linkId":"Section-20/A0100B","prefix":"A0100B","text":"Does the patient have a CMS Certification Number (CCN)?","type":"text","repeats":false,"readOnly":false,"maxLength":12},{"linkId":"Section-20/A0600A","prefix":"A0600A","text":"What is the patient's Social Security Number?","type":"text","repeats":false,"readOnly":false,"maxLength":9},{"linkId":"Section-20/A0600B","prefix":"A0600B","text":"What is the patient's Medicare number?","type":"text","repeats":false,"readOnly":false,"maxLength":12},{"linkId":"Section-20/A0700","prefix":"A0700","text":"The patient's Medicaid number should be entered in the provided space. If the Medicaid application is pending, enter \"+\". If the patient is not a Medicaid recipient, enter \"N\".","type":"text","repeats":false,"readOnly":false,"maxLength":14},{"linkId":"Section-20/A0800","prefix":"A0800","text":"What is the patient's gender? The possible answers are male, female, or prefer not to say.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://loinc.org","code":"LA2-8","display":"Male"}},{"valueCoding":{"system":"http://loinc.org","code":"LA3-6","display":"Female"}}]},{"linkId":"Section-20/A0900","prefix":"A0900","text":"What is the patient's birth date?","type":"open-choice","repeats":false,"readOnly":false},{"linkId":"Section-20/M0014","prefix":"M0014","text":"In which state does the patient currently reside?","type":"text","repeats":false,"readOnly":false,"maxLength":2},{"linkId":"Section-20/M0016","prefix":"M0016","text":"What is the patient's Branch ID Number?","type":"text","repeats":false,"readOnly":false,"maxLength":10},{"linkId":"Section-20/M0020","prefix":"M0020","text":"What is the patient's or resident's ID number?","type":"text","repeats":false,"readOnly":false,"maxLength":20},{"linkId":"Section-20/M0030","prefix":"M0030","text":"What is the start of care date for the patient?","type":"open-choice","repeats":false,"readOnly":false},{"linkId":"Section-20/M0032","prefix":"M0032","text":"The date of the patient's resumption of care is?","type":"open-choice","repeats":false,"readOnly":false},{"linkId":"Section-20/M0050","prefix":"M0050","text":"What is the patient's state of residence?","type":"text","repeats":false,"readOnly":false,"maxLength":2},{"linkId":"Section-20/A0550","prefix":"A0550","text":"What is the patient's or resident's ZIP code?","type":"text","repeats":false,"readOnly":false,"maxLength":11},{"linkId":"Section-20/A0500A","prefix":"A0500A","text":"What is the patient's first name?","type":"text","repeats":false,"readOnly":false,"maxLength":12},{"linkId":"Section-20/A0500B","prefix":"A0500B","text":"What is the patient's middle initial?","type":"text","repeats":false,"readOnly":false,"maxLength":1},{"linkId":"Section-20/A0500C","prefix":"A0500C","text":"The patient's last name is required.","type":"text","repeats":false,"readOnly":false,"maxLength":18},{"linkId":"Section-20/A0500D","prefix":"A0500D","text":"What is the patient's suffix?","type":"text","repeats":false,"readOnly":false,"maxLength":3},{"linkId":"Section-35/M0906","prefix":"M0906","text":"The form asks for the date of the patient's or resident's discharge, transfer, or death at home to be entered in the \"Discharge/Transfer/Death Date\" field.","type":"open-choice","repeats":false,"readOnly":false},{"linkId":"Section-31/N2005","prefix":"N2005","text":"Did the facility or setting contact and complete the actions prescribed or recommended by the physician, or the physician's designee, by midnight of the next calendar day each time potential clinically significant medication issues were identified for the patient since their admission?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://loinc.org","code":"LA32-8","display":"No"}},{"valueCoding":{"system":"http://loinc.org","code":"LA33-6","display":"Yes"}},{"valueCoding":{"system":"http://loinc.org","code":"LA27681-8","display":"NA-There were no potential clinically significant medication issues identified since SOC/ROC or patient is not taking any medications"}}]},null,{"linkId":"Section-10/J1900A","prefix":"J1900A","text":"The patient exhibits no injury - there is no evidence of any injury noted on the physical assessment performed by the nurse or primary care clinician; the patient has made no complaints of pain or injury; moreover, there has been no change in the patient's behavior after the fall.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://loinc.org","code":"LA137-2","display":"None"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6306-0","display":"One"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11073-6","display":"Two or more"}}]},{"linkId":"Section-10/J1900B","prefix":"J1900B","text":"The form asks whether the patient has any minor injuries, including skin tears, abrasions, lacerations, superficial bruises, hematomas, and sprains, or any fall-related injury that has caused them to complain of pain.","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://loinc.org","code":"LA137-2","display":"None"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6306-0","display":"One"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11073-6","display":"Two or more"}}]},{"linkId":"Section-10/J1900C","prefix":"J1900C","text":"Has the patient had any major injuries such as bone fractures, joint dislocations, closed head injuries with altered consciousness, or subdural hematoma?","type":"choice","repeats":false,"readOnly":false,"answerOption":[{"valueCoding":{"system":"http://loinc.org","code":"LA137-2","display":"None"}},{"valueCoding":{"system":"http://loinc.org","code":"LA6306-0","display":"One"}},{"valueCoding":{"system":"http://loinc.org","code":"LA11073-6","display":"Two or more"}}]}],"_id":"XentnaxzELai62Yke"}
{"resourceType":"QuestionnaireResponse","id":"OASIS-E-012023-1","questionnaire":"OASIS-E-012023","title":"Outcome and Assessment Information Set (E)","status":"draft","authored":"2024-06-05T20:27:15.723Z","item":[{"repeats":false,"linkId":"Section A. Administrative Information /A1005","prefix":"A1005","readOnly":false,"text":"Ethnicity. Are you of Hispanic, Latino/a, or Spanish origin?","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"A","display":"No, not of Hispanic, Latino/a, or Spanish origin"}},{"valueCoding":{"system":"http://del.cms.gov","code":"B","display":"Yes, Mexican, Mexican American, Chicano/a"}},{"valueCoding":{"system":"http://del.cms.gov","code":"C","display":"Yes, Puerto Rican"}},{"valueCoding":{"system":"http://del.cms.gov","code":"D","display":"Yes, Cuban"}},{"valueCoding":{"system":"http://del.cms.gov","code":"E","display":"Yes, another Hispanic, Latino, or Spanish origin"}},{"valueCoding":{"system":"http://del.cms.gov","code":"X","display":"{Patient/Resident/Person} unable to respond"}},{"valueCoding":{"system":"http://del.cms.gov","code":"Y","display":"{Patient/Resident/Person} declines to respond"}}]},{"repeats":false,"linkId":"Section A. Administrative Information /A1010","prefix":"A1010","readOnly":false,"text":"Race. What is your race?","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"A","display":"White"}},{"valueCoding":{"system":"http://del.cms.gov","code":"B","display":"Black or African American"}},{"valueCoding":{"system":"http://del.cms.gov","code":"C","display":"American Indian or Alaska Native"}},{"valueCoding":{"system":"http://del.cms.gov","code":"D","display":"Asian Indian"}},{"valueCoding":{"system":"http://del.cms.gov","code":"E","display":"Chinese"}},{"valueCoding":{"system":"http://del.cms.gov","code":"F","display":"Filipino"}},{"valueCoding":{"system":"http://del.cms.gov","code":"G","display":"Japanese"}},{"valueCoding":{"system":"http://del.cms.gov","code":"H","display":"Korean"}},{"valueCoding":{"system":"http://del.cms.gov","code":"I","display":"Vietnamese"}},{"valueCoding":{"system":"http://del.cms.gov","code":"J","display":"Other Asian"}},{"valueCoding":{"system":"http://del.cms.gov","code":"K","display":"Native Hawaiian"}},{"valueCoding":{"system":"http://del.cms.gov","code":"L","display":"Guamanian or Chamorro"}},{"valueCoding":{"system":"http://del.cms.gov","code":"M","display":"Samoan"}},{"valueCoding":{"system":"http://del.cms.gov","code":"N","display":"Other Pacific Islander"}},{"valueCoding":{"system":"http://del.cms.gov","code":"X","display":"{Patient/Resident/Person} unable to respond"}},{"valueCoding":{"system":"http://del.cms.gov","code":"Y","display":"{Patient/Resident/Person} declines to respond"}},{"valueCoding":{"system":"http://del.cms.gov","code":"Z","display":"None of the above"}}]},{"repeats":false,"linkId":"Section A. Administrative Information /A1110","prefix":"A1110","readOnly":false,"text":"Language","type":"question"},{"repeats":false,"linkId":"Section A. Administrative Information /A1110A","prefix":"A1110A","readOnly":false,"text":"What is your preferred language?","type":"text"},{"repeats":false,"linkId":"Section A. Administrative Information /A1110B","prefix":"A1110B","readOnly":false,"text":"Do you need or want an interpreter to communicate with a doctor or health care staff?","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"Unable to determine"}}]},{"repeats":false,"linkId":"Section A. Administrative Information /A1250","prefix":"A1250","readOnly":false,"text":"Transportation (from NACHC). Has lack of transportation kept you from medical appointments, meetings, work, or from getting things needed from daily living? ","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"A","display":"Yes, it has kept me from medical appointments or from getting my medications"}},{"valueCoding":{"system":"http://del.cms.gov","code":"B","display":"Yes, it has kept me from non-medical meetings, appointments, work, or from getting things that I need"}},{"valueCoding":{"system":"http://del.cms.gov","code":"C","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"X","display":"{Patient/Resident/Person} unable to respond"}},{"valueCoding":{"system":"http://del.cms.gov","code":"Y","display":"{Patient/Resident/Person} declines to respond"}}]},{"repeats":false,"linkId":"Section A. Administrative Information /A2120","prefix":"A2120","readOnly":false,"text":"Provision of Current Reconciled Medication List to Subsequent Provider at Transfer. At the time of transfer to another provider, did your agency provide the patient's current reconciled medication list to the subsequent provider?","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No - Current reconciled medication list not provided to the subsequent provider"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes - Current reconciled medication list provided to the subsequent provider"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"NA - The agency was not made aware of this transfer timely"}}]},{"repeats":false,"linkId":"Section A. Administrative Information /A2121","prefix":"A2121","readOnly":false,"text":"Provision of Current Reconciled Medication List to Subsequent Provider at Discharge. At the time of discharge to another provider, did your agency provide the patient's current reconciled medication list to the subsequent provider?","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"^","display":"Blank (skip pattern)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No - Current reconciled medication list not provided to the subsequent provider"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes - Current reconciled medication list provided to the subsequent provider"}}]},{"repeats":false,"linkId":"Section A. Administrative Information /A2122","prefix":"A2122","readOnly":false,"text":"Route of Current Reconciled Medication List Transmission to Subsequent Provider. ","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"^","display":"Blank (skip pattern)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"A","display":"Electronic Health Record"}},{"valueCoding":{"system":"http://del.cms.gov","code":"B","display":"Health Information Exchange"}},{"valueCoding":{"system":"http://del.cms.gov","code":"C","display":"Verbal (e.g., in-person, telephone, video conferencing)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"D","display":"Paper-based (e.g., fax, copies, printouts)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"E","display":"Other Methods (e.g., texting, email, CDs)"}}]},{"repeats":false,"linkId":"Section A. Administrative Information /A2123","prefix":"A2123","readOnly":false,"text":"Provision of Current Reconciled Medication List to Patient at Discharge. At the time of discharge, did your facility provide the patient's current reconciled medication list to the patient, family and/or caregiver?","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No - Current reconciled medication list not provided to the {patient/resident/person}, family and/or caregiver"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes - Current reconciled medication list provided to the {patient/resident/person}, family and/or caregiver"}}]},{"repeats":false,"linkId":"Section A. Administrative Information /A2124","prefix":"A2124","readOnly":false,"text":"Route of Current Reconciled Medication List Transmission to Patient. Indicate the route(s) of transmission of the current reconciled medication list to the patient/family/caregiver.","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"^","display":"Blank (skip pattern)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"A","display":"Electronic Health Record"}},{"valueCoding":{"system":"http://del.cms.gov","code":"B","display":"Health Information Exchange"}},{"valueCoding":{"system":"http://del.cms.gov","code":"C","display":"Verbal (e.g., in-person, telephone, video conferencing)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"D","display":"Paper-based (e.g., fax, copies, printouts)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"E","display":"Other Methods (e.g., texting, email, CDs)"}}]},{"repeats":false,"linkId":"Section B. Hearing, Speech, and Vision /B0200","prefix":"B0200","readOnly":false,"text":"Hearing. Ability to hear (with hearing aid or hearing appliances if normally used)","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Adequate - no difficulty in normal conversation, social interaction, listening to TV"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Minimal difficulty - difficulty in some environments (e.g., when person speaks softly or setting is noisy)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Moderate difficulty - speaker has to increase volume and speak distinctly"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Highly impaired - absence of useful hearing"}}]},{"repeats":false,"linkId":"Section B. Hearing, Speech, and Vision /B1000","prefix":"B1000","readOnly":false,"text":"Vision. Ability to see in adequate light (with glasses or other visual appliances)","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Adequate - sees fine detail, such as regular print in newspapers/books"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Impaired - sees large print, but not regular print in newspapers/books"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Moderately impaired - limited vision; not able to see newspaper headlines but can identify objects"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Highly impaired - object identification in question, but eyes appear to follow objects"}},{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Severely impaired - no vision or sees only light, colors or shapes; eyes do not appear to follow objects"}}]},{"repeats":false,"linkId":"Section B. Hearing, Speech, and Vision /B1300","prefix":"B1300","readOnly":false,"text":"Health Literacy. How often do you need to have someone help you when you read instructions, pamphlets, or other written material from your doctor or pharmacy?","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Never"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Rarely"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Sometimes"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Often"}},{"valueCoding":{"system":"http://del.cms.gov","code":"4","display":"Always"}},{"valueCoding":{"system":"http://del.cms.gov","code":"7","display":"{Patient/Resident/Person} declines to respond"}},{"valueCoding":{"system":"http://del.cms.gov","code":"8","display":"{Patient/Resident/Person} unable to respond"}}]},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C0100","prefix":"C0100","readOnly":false,"text":"Should Brief Interview for Mental Status be Conducted? Attempt to conduct interview with all patients","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No ({patient/resident/person} is rarely/never understood)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}}]},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C0200","prefix":"C0200","readOnly":false,"text":"Repetition of Three Words - Ask patient: \"I am going to say three words for you to remember. Please repeat the words after I have said all three. The words are: sock, blue, and bed. Now tell me the three words.\" Number of words repeated after first attempt","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"^","display":"Blank (skip pattern)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"None"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"One"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Two"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Three"}}]},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C0300","prefix":"C0300","readOnly":false,"text":"Temporal Orientation (orientation to year, month, and day)","type":"question"},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C0300A","prefix":"C0300A","readOnly":false,"text":"Ask patient: \"Please tell me what year it is right now.\" Able to report correct year","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"^","display":"Blank (skip pattern)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Missed by > 5 years or no answer"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Missed by 2-5 years"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Missed by 1 year"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"Correct"}}]},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C0300B","prefix":"C0300B","readOnly":false,"text":"Ask patient: \"What month are we in right now?\" Able to report correct month","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"^","display":"Blank (skip pattern)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Missed by > 1 month or no answer"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Missed by 6 days to 1 month"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Accurate within 5 days"}}]},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C0300C","prefix":"C0300C","readOnly":false,"text":"Ask patient: \"What day of the week is today?\" Able to report correct day of the week","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"^","display":"Blank (skip pattern)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Incorrect or no answer"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Correct"}}]},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C0400","prefix":"C0400","readOnly":false,"text":"Recall. Ask patient: \"Let's go back to an earlier question. What were those three words that I asked you to repeat?\" If unable to remember a word, give cue (something to wear; a color; a piece of furniture) for that word.","type":"question"},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C0400A","prefix":"C0400A","readOnly":false,"text":"Able to recall \"sock\"","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"^","display":"Blank (skip pattern)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No - could not recall"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes, after cueing (\"something to wear\")"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Yes, no cue required"}}]},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C0400B","prefix":"C0400B","readOnly":false,"text":"Able to recall \"blue\"","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"^","display":"Blank (skip pattern)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No - could not recall"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes, after cueing (\"a color\")"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Yes, no cue required"}}]},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C0400C","prefix":"C0400C","readOnly":false,"text":"Able to recall \"bed\"","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"^","display":"Blank (skip pattern)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No - could not recall"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes, after cueing (\"a piece of furniture\")"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Yes, no cue required"}}]},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C0500","prefix":"C0500","readOnly":false,"text":"BIMS Summary Score. Add scores for C0200-C0400 and fill in total score (00-15). Enter 99 if the patient was unable to complete the interview","type":"integer"},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C1310","prefix":"C1310","readOnly":false,"text":"Signs and Symptoms of Delirium (from CAM©)","type":"question"},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C1310A","prefix":"C1310A","readOnly":false,"text":"Acute Onset Mental Status Change. Is there evidence of an acute change in mental status from the patient's baseline?","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes"}}]},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C1310B","prefix":"C1310B","readOnly":false,"text":"Inattention - Did the patient have difficulty focusing attention, for example, being easily distractible or having difficulty keeping track of what was being said?","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Behavior not present"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Behavior continuously present, does not fluctuate"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Behavior present, fluctuates (comes and goes, changes in severity)"}}]},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C1310C","prefix":"C1310C","readOnly":false,"text":"Disorganized Thinking - Was the patient's thinking disorganized or incoherent (rambling or irrelevant conversation, unclear or illogical flow of ideas, or unpredictable switching from subject to subject)?","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Behavior not present"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Behavior continuously present, does not fluctuate"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Behavior present, fluctuates (comes and goes, changes in severity)"}}]},{"repeats":false,"linkId":"Section C. Cognitive Patterns /C1310D","prefix":"C1310D","readOnly":false,"text":"Altered Level of Consciousness - Did the patient have altered level of consciousness, as indicated by any of the following criteria? vigilant - startled easily to any sound or touch, lethargic - repeatedly dozed off when being asked questions, but responded to voice or touch, stuporous - very difficult to arouse and keep aroused for the interview, comatose - could not be aroused","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Behavior not present"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Behavior continuously present, does not fluctuate"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"Behavior present, fluctuates (comes and goes, changes in severity)"}}]},{"repeats":false,"linkId":"Section D. Mood /D0150","prefix":"D0150","readOnly":false,"text":"Patient Mood Interview (PHQ-2 to 9). Say to patient: \"Over the last 2 weeks, have you been bothered by any of the following problems?\"","type":"question"},{"repeats":false,"linkId":"Section D. Mood /D0150_1","prefix":"D0150_1","readOnly":false,"text":"Symptom Presence","type":"question"},{"repeats":false,"linkId":"Section D. Mood /D0150_2","prefix":"D0150_2","readOnly":false,"text":"Symptom Frequency","type":"question"},{"repeats":false,"linkId":"Section D. Mood /D0150A1","prefix":"D0150A1","readOnly":false,"text":"Little interest or pleasure in doing things - Symptom Presence","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No (enter 0 in column 2)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes (enter 0-3 in column 2)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"No response (leave column 2 blank)"}}]},{"repeats":false,"linkId":"Section D. Mood /D0150A2","prefix":"D0150A2","readOnly":false,"text":"Little interest of pleasure in doing things - Symptom Frequency","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"^","display":"Blank (skip pattern)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"Never or 1 day"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"2-6 days (several days)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"2","display":"7-11 days (half or more of the days)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"3","display":"12-14 days (nearly every day)"}}]},{"repeats":false,"linkId":"Section D. Mood /D0150B1","prefix":"D0150B1","readOnly":false,"text":"Feeling down, depressed, or hopeless - Symptom Presence","type":"choice","answerOption":[{"valueCoding":{"system":"http://del.cms.gov","code":"-","display":"Not assessed/no information"}},{"valueCoding":{"system":"http://del.cms.gov","code":"0","display":"No (enter 0 in column 2)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"1","display":"Yes (enter 0-3 in column 2)"}},{"valueCoding":{"system":"http://del.cms.gov","code":"9","display":"No response (leave column 2 blank)"}}]},{"repeats":false,"linkId":"Section D. Mood /D0150B2","prefix":"D0150B2","readOnly":false,"text":"Feeling down, depressed, or hopeless - Symptom Frequency","type":"choice","answerOpti